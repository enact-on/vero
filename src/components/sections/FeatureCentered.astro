---
/**
 * Centered heading with one large framed product image below it, on a soft
 * warm glow.
 *
 * Frontmatter:
 *   - type: feature-centered
 *     eyebrow: MEET VERO AI
 *     title: Your dedicated revenue co-pilot.
 *     description: Interact with your GTM data naturally...
 *     image: /src/assets/images/visual-image-6.jpg
 *     imageAlt: Vero AI Revenue Copilot Dashboard
 */
import Container from "../ui/layout/Container.astro";
import Media from "../ui/primitives/Media.astro";
import { sectionClass, type BaseSectionProps } from "../../lib/sections";

interface Props extends BaseSectionProps {
  eyebrow?: string;
  title: string;
  description?: string;
  image: string;
  imageAlt?: string;
}

const { id, eyebrow, title, description, image, imageAlt } = Astro.props;
---

<section
  id={id}
  class={sectionClass(
    "section py-12 lg:py-24 bg-white relative overflow-hidden",
    Astro.props,
  )}
>
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-5xl h-[450px] bg-[radial-gradient(ellipse_60%_50%_at_50%_50%,rgba(234,88,12,0.06)_0%,transparent_70%)] pointer-events-none -z-10"
  >
  </div>

  <Container>
    <div class="flex flex-col mb-12 items-center text-center">
      {
        eyebrow && (
          <span
            class="text-eyebrow text-primary font-semibold text-sm tracking-wider uppercase mb-3"
            set:html={eyebrow}
          />
        )
      }
      <h2 class="text-h2 mb-4" set:html={title} />
      {
        description && (
          <p
            class="text-body-large max-w-[700px] m-0 text-text-secondary"
            set:html={description}
          />
        )
      }
    </div>
    <div
      class="visual-centered mt-12 max-w-5xl mx-auto rounded-2xl border border-gray-200/90 shadow-[0_25px_60px_-15px_rgba(234,88,12,0.12),0_12px_28px_-6px_rgba(15,23,42,0.06)] overflow-hidden bg-white transition-all duration-300 hover:shadow-[0_30px_70px_-15px_rgba(234,88,12,0.18)]"
    >
      <Media src={image} alt={imageAlt ?? ""} class="w-full h-auto block" />
    </div>
  </Container>
</section>
