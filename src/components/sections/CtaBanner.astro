---
/**
 * Rounded primary-colour CTA card with background image, icon badge,
 * heading, description and buttons.
 *
 * Frontmatter:
 *   - type: cta-banner
 *     icon: rocket_launch                 # optional Material Symbols name
 *     title: Build your next pipeline advantage.
 *     description: See how Vero can help your team ...
 *     buttons:
 *       - { label: Get started, href: "#", variant: primary, icon: arrow_forward }
 *       - { label: Book a demo, href: "#", variant: outline }   # primary | outline
 *     backgroundImage: /src/assets/images/cta-bg.png
 *     backgroundImageAlt: CTA Background
 */
import Media from "../ui/primitives/Media.astro";
import { sectionClass, type BaseSectionProps } from "../../lib/sections";

interface Button {
  label: string;
  href: string;
  variant?: "primary" | "outline";
  icon?: string;
}

interface Props extends BaseSectionProps {
  icon?: string;
  title: string;
  description?: string;
  buttons?: Button[];
  backgroundImage?: string;
  backgroundImageAlt?: string;
}

const {
  id,
  icon,
  title,
  description,
  buttons = [],
  backgroundImage,
  backgroundImageAlt,
} = Astro.props;

const buttonVariants = {
  primary:
    "px-[24px] py-[14px] bg-white text-[#2A2732] font-[700] text-[16px] rounded-[7px] shadow-[0px_6px_18px_rgba(22,22,26,0.12)] hover:-translate-y-0.5 hover:shadow-[0px_10px_20px_rgba(22,22,26,0.2)] transition-all flex items-center gap-2",
  outline:
    "px-[24px] py-[14px] border border-white/30 text-white font-[700] text-[16px] rounded-[7px] hover:bg-white/10 transition-colors",
};
---

<section id={id} class={sectionClass("py-[80px] bg-[#FAFAF8]", Astro.props)}>
  <div class="max-w-[1180px] mx-auto px-4">
    <div
      data-animate="fade-up"
      class="bg-primary rounded-[14px] p-[80px_20px] text-center relative overflow-hidden flex flex-col items-center"
    >
      <div class="absolute inset-0 bg-gradient-to-b from-white/5 to-transparent pointer-events-none" />
      {
        backgroundImage && (
          <div class="absolute inset-0 pointer-events-none">
            <Media
              src={backgroundImage}
              alt={backgroundImageAlt ?? ""}
              class="w-full h-full object-cover"
            />
          </div>
        )
      }

      {
        icon && (
          <div class="w-[48px] h-[48px] rounded-full bg-white/10 border border-white/20 flex items-center justify-center mb-[22px] relative z-10 shadow-inner">
            <span class="material-symbols-outlined text-white text-[24px]">{icon}</span>
          </div>
        )
      }

      <h2 class="text-h2 text-white mb-[19px] relative z-10" set:html={title} />
      {
        description && (
          <p
            class="text-[16px] text-[#D8D3F5] max-w-[570px] mx-auto mb-[27px] leading-[22.1px] relative z-10"
            set:html={description}
          />
        )
      }

      {
        buttons.length > 0 && (
          <div class="flex items-center justify-center gap-[15px] relative z-10">
            {buttons.map((button) => (
              <a href={button.href} class={buttonVariants[button.variant ?? "primary"]}>
                <Fragment set:html={button.label} />
                {button.icon && (
                  <span class="material-symbols-outlined text-[16px]">{button.icon}</span>
                )}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
