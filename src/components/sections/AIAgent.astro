---
import ProductShell from './ProductShell.astro';
import { Image } from 'astro:assets';
---

<ProductShell title="Vero AI Agent" activeSidebarItem="overview" class="w-full">
  <div class="flex flex-col h-full bg-white rounded-lg border border-border">
    <div class="flex-1 p-6 overflow-y-auto flex flex-col gap-6">
      <!-- AI Message -->
      <div class="flex gap-3 max-w-[85%]">
        <div class="w-7 h-7 rounded-full shrink-0 flex items-center justify-center overflow-hidden bg-gradient-to-br from-primary to-orange-400">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
        </div>
        <div class="text-[15px] leading-relaxed text-text-primary">
          <p class="m-0">I found <strong>12 new accounts</strong> showing high intent for "Data Orchestration" in the last 24 hours. They all match your ICP.</p>
          
          <div class="mt-4 border border-border rounded-md bg-gray-50 overflow-hidden">
            <div class="flex justify-between items-center p-3 border-b border-border bg-white">
              <span class="text-[13px] font-semibold">ICP Matches (High Intent)</span>
              <span class="text-[11px] bg-primary-soft text-primary py-0.5 px-1.5 rounded-sm font-semibold">12 Accounts</span>
            </div>
            <div class="p-3 flex flex-col gap-2">
              <div class="flex justify-between text-[13px]">
                <span class="font-medium">Stark Industries</span>
                <span class="text-emerald-500 font-semibold">Score: 98</span>
              </div>
              <div class="flex justify-between text-[13px]">
                <span class="font-medium">Wayne Enterprises</span>
                <span class="text-emerald-500 font-semibold">Score: 94</span>
              </div>
            </div>
            <div class="p-2 px-3 border-t border-border bg-white">
              <button class="w-full p-1.5 bg-primary text-white border-none rounded-sm text-xs font-medium cursor-pointer">Add to sequence</button>
            </div>
          </div>
        </div>
      </div>
      
      <!-- User Message -->
      <div class="flex gap-3 max-w-[85%] self-end justify-end">
        <div class="text-[15px] leading-relaxed bg-primary text-white py-3 px-4 rounded-[18px_18px_0_18px]">
          <p class="m-0">Add the top 5 to the "Q3 Enterprise Outreach" sequence and draft emails mentioning their recent funding if applicable.</p>
        </div>
        <div class="w-7 h-7 rounded-full shrink-0 flex items-center justify-center overflow-hidden">
          <Image src="https://i.pravatar.cc/100?img=33" alt="You" width={100} height={100} class="w-full h-full object-cover" />
        </div>
      </div>
      
      <!-- AI Message -->
      <div class="flex gap-3 max-w-[85%]">
        <div class="w-7 h-7 rounded-full shrink-0 flex items-center justify-center overflow-hidden bg-gradient-to-br from-primary to-orange-400">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>
        </div>
        <div class="text-[15px] leading-relaxed text-text-primary">
          <div class="flex gap-1 py-2 px-3 bg-gray-100 rounded-[18px_18px_18px_0] w-fit">
            <span class="typing-dot" style="animation-delay: -0.32s"></span>
            <span class="typing-dot" style="animation-delay: -0.16s"></span>
            <span class="typing-dot"></span>
          </div>
        </div>
      </div>
    </div>
    
    <div class="p-4 border-t border-border bg-gray-50">
      <div class="flex items-center bg-white border border-border rounded-full py-1 pr-1 pl-4 shadow-sm">
        <input type="text" placeholder="Ask Vero AI to research accounts, draft emails, or build workflows..." class="flex-1 border-none outline-none text-sm" />
        <button class="w-8 h-8 rounded-full bg-primary text-white border-none flex items-center justify-center cursor-pointer shrink-0">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
      </div>
      <div class="flex gap-2 mt-3 pl-3">
        <span class="text-xs text-text-secondary bg-white border border-border py-1 px-2.5 rounded-full cursor-pointer transition-colors duration-200 hover:bg-gray-50 hover:border-gray-300">Research competitors of Acme Corp</span>
        <span class="text-xs text-text-secondary bg-white border border-border py-1 px-2.5 rounded-full cursor-pointer transition-colors duration-200 hover:bg-gray-50 hover:border-gray-300">Summarize pipeline risks</span>
      </div>
    </div>
  </div>
</ProductShell>

<style>
  .typing-dot {
    width: 6px;
    height: 6px;
    background: #9CA3AF;
    border-radius: 50%;
    animation: typing 1.4s infinite ease-in-out both;
  }
  @keyframes typing {
    0%, 80%, 100% { transform: scale(0); }
    40% { transform: scale(1); }
  }
</style>
