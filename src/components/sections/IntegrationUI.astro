---
import ProductShell from "./ProductShell.astro";
---

<ProductShell title="Integrations" activeSidebarItem="overview" class="w-full">
  <div class="mb-6">
    <h3 class="m-0 mb-1 text-lg font-semibold">Connected Apps</h3>
    <p class="m-0 text-sm text-text-secondary">
      Vero syncs bi-directionally with your GTM stack.
    </p>
  </div>

  <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-5">
    <div
      class="bg-white border border-gray-200 rounded-2xl p-6 flex flex-col h-full shadow-[0_4px_20px_rgba(0,0,0,0.03)]"
    >
      <div class="flex justify-between items-start mb-4">
        <div
          class="w-12 h-12 rounded-md flex items-center justify-center bg-[#00A1E0]"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="white"
            ><path
              d="M17.5 7.5c-1.2 0-2.3.4-3.2 1-1.3-2.1-3.6-3.5-6.3-3.5-3.4 0-6.2 2.3-7.5 5.5C.4 10.7 0 11.3 0 12c0 2.2 1.8 4 4 4h15c2.8 0 5-2.2 5-5s-2.2-5-5-5c-.5 0-1 .1-1.5.3z"
            ></path></svg
          >
        </div>
        <div
          class="flex items-center gap-1.5 text-xs font-medium text-emerald-500 bg-emerald-50 py-0.5 px-2 rounded-full"
        >
          <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span> Connected
        </div>
      </div>
      <div class="flex-1 mb-6">
        <h4 class="m-0 mb-1.5 text-[17px] text-gray-900 font-semibold">
          Salesforce
        </h4>
        <p class="m-0 text-sm text-gray-500 leading-relaxed">
          Sync accounts, contacts, and opportunities
        </p>
      </div>
      <div
        class="flex justify-between items-center border-t border-gray-100 pt-4 mt-auto"
      >
        <span class="text-xs text-gray-400 font-medium">Last synced 2m ago</span
        >
        <button
          class="bg-transparent border-none text-gray-500 cursor-pointer p-1.5 rounded-md flex items-center justify-center transition-colors hover:bg-gray-100 hover:text-gray-900"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><circle cx="12" cy="12" r="3"></circle><path
              d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
            ></path></svg
          >
        </button>
      </div>
    </div>

