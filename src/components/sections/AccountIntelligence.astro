---
import ProductShell from './ProductShell.astro';
---

<ProductShell title="Account Intelligence" activeSidebarItem="accounts" class="w-full max-w-[900px] mx-auto">
  <div class="flex justify-between items-center mb-6">
    <div class="flex items-center gap-3">
      <h3 class="m-0 text-lg font-semibold">Target Accounts</h3>
      <span class="bg-primary-soft text-primary text-xs font-semibold py-0.5 px-2 rounded-full">12 High Intent</span>
    </div>
    <div class="flex gap-3">
      <div class="flex items-center gap-2 bg-white border border-border rounded-md px-3 h-8 text-text-muted text-[13px] w-[200px]">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <span>Search accounts...</span>
      </div>
      <button class="flex items-center gap-1.5 bg-white border border-border rounded-md px-3 h-8 text-text-secondary text-[13px] font-medium cursor-pointer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
        Filter
      </button>
    </div>
  </div>

  <div class="bg-white rounded-lg border border-border overflow-x-auto">
    <div class="flex bg-gray-50 border-b border-border py-3 px-4 text-xs font-semibold text-text-muted uppercase tracking-wider min-w-[700px]">
      <div class="flex items-center flex-[2] gap-3">Company</div>
      <div class="flex items-center flex-1 gap-2">Intent Score</div>
      <div class="flex items-center flex-[2] gap-2 flex-wrap">Key Signals</div>
      <div class="flex items-center flex-1 justify-end">Action</div>
    </div>
    
    <div class="flex items-center p-4 border-b border-border transition-colors duration-200 hover:bg-gray-50 min-w-[700px]">
      <div class="flex items-center flex-[2] gap-3">
        <div class="w-8 h-8 rounded-md flex items-center justify-center font-bold text-white text-sm bg-gradient-to-br from-blue-500 to-blue-600">A</div>
        <div class="flex flex-col">
          <span class="text-sm font-semibold text-text-primary">Acme Corp</span>
          <span class="text-xs text-text-muted">Enterprise Software</span>
        </div>
      </div>
      <div class="flex items-center flex-1 gap-2">
        <div class="text-sm font-bold text-success">98</div>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
      </div>
      <div class="flex items-center flex-[2] gap-2 flex-wrap">
        <div class="bg-gray-100 text-text-secondary text-xs py-0.5 px-2 rounded-sm whitespace-nowrap">Pricing Page (3x)</div>
        <div class="bg-gray-100 text-text-secondary text-xs py-0.5 px-2 rounded-sm whitespace-nowrap">Competitor Switch</div>
      </div>
      <div class="flex items-center flex-1 justify-end">
        <button class="bg-primary text-white border-none rounded-md py-1.5 px-3 text-xs font-semibold cursor-pointer">Add to Campaign</button>
      </div>
    </div>

    <div class="flex items-center p-4 border-b border-border transition-colors duration-200 hover:bg-gray-50 min-w-[700px]">
      <div class="flex items-center flex-[2] gap-3">
        <div class="w-8 h-8 rounded-md flex items-center justify-center font-bold text-white text-sm bg-gradient-to-br from-emerald-500 to-emerald-600">G</div>
        <div class="flex flex-col">
          <span class="text-sm font-semibold text-text-primary">Globex Inc</span>
          <span class="text-xs text-text-muted">Financial Services</span>
        </div>
      </div>
      <div class="flex items-center flex-1 gap-2">
        <div class="text-sm font-bold text-success">92</div>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
      </div>
      <div class="flex items-center flex-[2] gap-2 flex-wrap">
        <div class="bg-gray-100 text-text-secondary text-xs py-0.5 px-2 rounded-sm whitespace-nowrap">Exec Hiring</div>
        <div class="bg-gray-100 text-text-secondary text-xs py-0.5 px-2 rounded-sm whitespace-nowrap">SOC2 Research</div>
      </div>
      <div class="flex items-center flex-1 justify-end">
        <button class="bg-primary text-white border-none rounded-md py-1.5 px-3 text-xs font-semibold cursor-pointer">Add to Campaign</button>
      </div>
    </div>
    
    <div class="flex items-center p-4 transition-colors duration-200 hover:bg-gray-50 min-w-[700px]">
      <div class="flex items-center flex-[2] gap-3">
        <div class="w-8 h-8 rounded-md flex items-center justify-center font-bold text-white text-sm bg-gradient-to-br from-amber-500 to-amber-600">S</div>
        <div class="flex flex-col">
          <span class="text-sm font-semibold text-text-primary">Soylent Corp</span>
          <span class="text-xs text-text-muted">Manufacturing</span>
        </div>
      </div>
      <div class="flex items-center flex-1 gap-2">
        <div class="text-sm font-bold text-warning">74</div>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      </div>
      <div class="flex items-center flex-[2] gap-2 flex-wrap">
        <div class="bg-gray-100 text-text-secondary text-xs py-0.5 px-2 rounded-sm whitespace-nowrap">Funding Round</div>
      </div>
      <div class="flex items-center flex-1 justify-end">
        <button class="bg-white text-text-secondary border border-border rounded-md py-1.5 px-3 text-xs font-semibold cursor-pointer">Monitor</button>
      </div>
    </div>
  </div>
</ProductShell>
