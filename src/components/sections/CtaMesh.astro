---
/**
 * Light final call-to-action over an ambient gradient mesh + grid pattern.
 *
 * Frontmatter:
 *   - type: cta-mesh
 *     badge: Start building today
 *     title: Build your team of revenue agents.
 *     description: Create AI agents that understand your business ...
 *     buttons:
 *       - { label: Get started free, href: "#", variant: primary }   # primary (with arrow) | secondary
 *       - { label: Book a demo, href: "#", variant: secondary }
 */
import { sectionClass, type BaseSectionProps } from "../../lib/sections";

interface Button {
  label: string;
  href: string;
  variant?: "primary" | "secondary";
}

interface Props extends BaseSectionProps {
  badge?: string;
  title: string;
  description?: string;
  buttons?: Button[];
}

const { id, badge, title, description, buttons = [] } = Astro.props;
---

<section
  id={id}
  class={sectionClass(
    "w-full py-32 relative overflow-hidden bg-white border-t border-gray-200/60",
    Astro.props,
  )}
>
  <div class="absolute inset-0 w-full h-full z-0">
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-gradient-to-r from-indigo-200/50 via-purple-200/50 to-emerald-100/50 rounded-full blur-[100px] opacity-70 pointer-events-none"
    >
    </div>
  </div>

  <div
    class="absolute inset-0 -z-0 bg-[linear-gradient(to_right,#8080800a_1px,transparent_1px),linear-gradient(to_bottom,#8080800a_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)]"
  >
  </div>

  <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
    {
      badge && (
        <div
          data-animate="fade-up"
          class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-gray-200 shadow-sm text-xs font-semibold text-gray-700 mb-8"
        >
          <span class="w-2 h-2 rounded-full bg-primary animate-pulse" />
          <Fragment set:html={badge} />
        </div>
      )
    }

    <h2
      data-animate="fade-up"
      class="text-h1 text-gray-950 font-[650] tracking-[-0.05em] leading-[1.05] mb-6"
      set:html={title}
    />
    {
      description && (
        <p
          data-animate="fade-up"
          class="text-[18px] text-gray-600 font-[400] leading-[28px] max-w-2xl mx-auto mb-10"
          set:html={description}
        />
      )
    }

    {
      buttons.length > 0 && (
        <div
          data-animate="fade-up"
          class="flex flex-wrap items-center justify-center gap-4 w-full"
        >
          {buttons.map((button) =>
            (button.variant ?? "primary") === "primary" ? (
              <a
                href={button.href}
                class="inline-flex items-center justify-center gap-2 h-12 px-8 rounded-xl bg-gray-950 text-white font-[600] transition-all hover:bg-black hover:-translate-y-0.5 shadow-lg shadow-gray-900/20 group"
              >
                <Fragment set:html={button.label} />
                <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">
                  arrow_forward
                </span>
              </a>
            ) : (
              <a
                href={button.href}
                class="inline-flex items-center justify-center gap-2 h-12 px-8 rounded-xl bg-white border border-gray-200 text-gray-800 font-[600] transition-all hover:bg-gray-50 hover:-translate-y-0.5 shadow-sm"
                set:html={button.label}
              />
            ),
          )}
        </div>
      )
    }
  </div>
</section>
