---
/**
 * Two-column hero: announcement pill, headline with gradient highlight,
 * CTAs and rating on the left; product image with two floating cards on the
 * right; logo marquee along the bottom. Without `image` a built-in vector
 * dashboard mockup is shown instead.
 *
 * Frontmatter:
 *   - type: hero-spotlight
 *     badge: { text: Vero AI 2.0 is now live, linkLabel: "See what's new", href: /product }
 *     title: The AI platform for
 *     titleHighlight: go-to-market teams      # gradient text on its own line
 *     description: Built on the world's best B2B data...
 *     primaryCta: { label: Start free trial, href: /login }
 *     secondaryCta: { label: Book a demo, href: /company/contact }
 *     avatars:                                # social-proof avatar stack
 *       - { initials: SK, tone: orange }      # orange | slate | amber | zinc
 *     rating: { stars: 5, score: 4.9/5, text: "from 500+ reviews on G2 &amp; Capterra" }
 *     image: /src/assets/images/vero-dashboard-hero.png
 *     imageAlt: Vero Dashboard
 *     signalCard: { title: Stripe Inc., badge: 98% Hot, text: Pricing page 4x · Surge detected }
 *     successCard: { title: Meeting Booked, text: VP of Sales @ Datadog }
 *     logos:                                  # text wordmarks, looped in the marquee
 *       - name: stripe
 *         weight: bold                        # semibold | bold | black (default bold)
 *         tracking: tight                     # tighter | tight | wide | widest (default tight)
 *         small: false                        # smaller text size
 *         uppercase: false
 */
import Container from "../ui/layout/Container.astro";
import Media from "../ui/primitives/Media.astro";
import { sectionClass, type BaseSectionProps } from "../../lib/sections";

interface Link {
  label: string;
  href: string;
}

interface Logo {
  name: string;
  weight?: "semibold" | "bold" | "black";
  tracking?: "tighter" | "tight" | "wide" | "widest";
  small?: boolean;
  uppercase?: boolean;
}

interface Props extends BaseSectionProps {
  badge?: { text: string; linkLabel?: string; href: string };
  title: string;
  titleHighlight?: string;
  description?: string;
  primaryCta?: Link;
  secondaryCta?: Link;
  avatars?: { initials: string; tone?: "orange" | "slate" | "amber" | "zinc" }[];
  rating?: { stars?: number; score?: string; text?: string };
  image?: string;
  imageAlt?: string;
  signalCard?: { title: string; badge?: string; text?: string };
  successCard?: { title: string; text?: string };
  logos?: Logo[];
}

const {
  id,
  badge,
  title,
  titleHighlight,
  description,
  primaryCta,
  secondaryCta,
  avatars = [],
  rating,
  image,
  imageAlt,
  signalCard,
  successCard,
  logos = [],
} = Astro.props;

const avatarTones = {
  orange: "from-orange-400 to-amber-300",
  slate: "from-slate-700 to-slate-900",
  amber: "from-amber-500 to-orange-600",
  zinc: "from-zinc-700 to-zinc-900",
};

const weights = {
  semibold: "font-semibold",
  bold: "font-bold",
  black: "font-black",
};

const trackings = {
  tighter: "tracking-tighter",
  tight: "tracking-tight",
  wide: "tracking-wide",
  widest: "tracking-widest",
};

const logoClass = (logo: Logo) =>
  [
    weights[logo.weight ?? "bold"],
    logo.small ? "text-sm sm:text-base" : "text-base sm:text-lg",
    trackings[logo.tracking ?? "tight"],
    "text-gray-800",
    logo.uppercase && "uppercase",
  ]
    .filter(Boolean)
    .join(" ");

const stars = Array.from({ length: rating?.stars ?? 0 });
---

<section
  id={id}
  class={sectionClass(
    "relative overflow-hidden bg-gradient-to-b from-orange-50/50 via-white to-white flex flex-col justify-between lg:h-[calc(100vh-108px)] lg:min-h-[640px] lg:max-h-[870px] pt-4 lg:pt-3 pb-2",
    Astro.props,
  )}
>
  <!-- Ambient Soft Background Lighting & Subtle Mesh -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[420px] bg-[radial-gradient(ellipse_60%_45%_at_50%_0%,rgba(234,88,12,0.1)_0%,transparent_70%)] pointer-events-none -z-10"
  >
  </div>
  <div
    class="absolute -top-10 right-[-3%] w-[460px] h-[460px] rounded-full bg-gradient-to-br from-primary/15 via-orange-400/10 to-amber-200/10 blur-[110px] pointer-events-none -z-10 animate-pulse-glow"
  >
  </div>
  <div
    class="absolute inset-0 bg-[linear-gradient(to_right,rgba(234,88,12,0.035)_1px,transparent_1px),linear-gradient(to_bottom,rgba(234,88,12,0.035)_1px,transparent_1px)] bg-[size:36px_36px] [mask-image:radial-gradient(ellipse_75%_60%_at_50%_35%,#000_50%,transparent_100%)] pointer-events-none -z-10"
  >
  </div>

  <Container class="flex-1 flex flex-col justify-between w-full h-full">
    <div
      class="grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-12 items-center flex-1 my-auto py-1 lg:py-2"
    >
      <!-- LEFT COLUMN: Copy & Actions -->
      <div
        class="lg:col-span-6 xl:col-span-6 flex flex-col items-start text-left z-10"
      >
        {
          badge && (
            <a
              href={badge.href}
              class="group inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/90 backdrop-blur-md border border-orange-200/80 shadow-2xs mb-3 hover:border-orange-300 hover:shadow-xs transition-all"
            >
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary/75 opacity-75" />
                <span class="relative inline-flex rounded-full h-2 w-2 bg-primary" />
              </span>
              <span class="text-xs font-semibold text-gray-800" set:html={badge.text} />
              {badge.linkLabel && (
                <>
                  <span class="text-gray-300">|</span>
                  <span class="text-xs font-semibold text-primary inline-flex items-center gap-0.5 group-hover:translate-x-0.5 transition-transform">
                    <Fragment set:html={badge.linkLabel} />
                    <svg class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor">
                      <path
                        fill-rule="evenodd"
                        d="M6.22 3.22a.75.75 0 011.06 0l4.25 4.25a.75.75 0 010 1.06l-4.25 4.25a.75.75 0 01-1.06-1.06L9.94 8 6.22 4.28a.75.75 0 010-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </span>
                </>
              )}
            </a>
          )
        }

        <h1
          class="text-3xl sm:text-4xl lg:text-[40px] xl:text-[46px] font-extrabold text-gray-950 tracking-[-0.035em] leading-[1.12] mb-3"
        >
          <Fragment set:html={title} />
          {
            titleHighlight && (
              <>
                {" "}
                <br class="hidden sm:inline" />
                <span
                  class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-orange-500 to-amber-500"
                  set:html={titleHighlight}
                />
              </>
            )
          }
        </h1>

        {
          description && (
            <p
              class="text-sm sm:text-base text-gray-600 max-w-lg mb-5 lg:mb-6 leading-relaxed font-normal"
              set:html={description}
            />
          )
        }

        {
          (primaryCta || secondaryCta) && (
            <div class="flex flex-wrap items-center gap-3.5 mb-5 w-full">
              {primaryCta && (
                <a
                  href={primaryCta.href}
                  class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-primary hover:bg-primary-hover active:bg-primary-active text-white font-semibold text-sm sm:text-base transition-all duration-200 shadow-md shadow-orange-500/25 hover:shadow-lg hover:shadow-orange-500/35 hover:-translate-y-0.5 group cursor-pointer"
                >
                  <span set:html={primaryCta.label} />
                  <svg
                    class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2.2"
                      d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                    />
                  </svg>
                </a>
              )}
              {secondaryCta && (
                <a
                  href={secondaryCta.href}
                  class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-white hover:bg-orange-50/50 border border-gray-200 hover:border-orange-200/90 text-gray-800 hover:text-gray-950 font-semibold text-sm sm:text-base transition-all duration-200 shadow-2xs hover:shadow-xs hover:-translate-y-0.5 group cursor-pointer"
                >
                  <span class="w-5 h-5 rounded-full bg-orange-100 flex items-center justify-center text-primary group-hover:scale-110 transition-transform shadow-2xs">
                    <svg class="w-3 h-3 fill-current ml-0.5" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                  <span set:html={secondaryCta.label} />
                </a>
              )}
            </div>
          )
        }

        {
          (avatars.length > 0 || rating) && (
            <div class="flex items-center gap-3.5 pt-3.5 border-t border-gray-200/60 w-full max-w-md">
              {avatars.length > 0 && (
                <div class="flex -space-x-1.5">
                  {avatars.map((avatar) => (
                    <div
                      class={`inline-flex h-7 w-7 rounded-full ring-2 ring-white bg-gradient-to-tr ${avatarTones[avatar.tone ?? "orange"]} items-center justify-center text-[10px] font-bold text-white shadow-2xs`}
                      set:html={avatar.initials}
                    />
                  ))}
                </div>
              )}
              {rating && (
                <div>
                  <div class="flex items-center gap-0.5 text-orange-400">
                    {stars.map(() => (
                      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))}
                    {rating.score && (
                      <span class="text-xs font-bold text-gray-900 ml-1" set:html={rating.score} />
                    )}
                  </div>
                  {rating.text && (
                    <p class="text-[11px] text-gray-500 mt-0.5" set:html={rating.text} />
                  )}
                </div>
              )}
            </div>
          )
        }
      </div>

      <!-- RIGHT COLUMN: Product visual with floating cards -->
      <div
        class="lg:col-span-6 xl:col-span-6 relative w-full flex items-center justify-center z-10"
      >
        <div
          class="absolute -inset-3 bg-gradient-to-tr from-primary/20 via-orange-400/15 to-amber-200/20 rounded-3xl blur-2xl -z-10 opacity-70"
        >
        </div>

        {
          signalCard && (
            <div class="absolute -top-3.5 sm:-top-5 -right-2 sm:-right-4 z-30 animate-float-slow max-w-[230px] sm:max-w-[250px] pointer-events-auto">
              <div class="bg-white/95 backdrop-blur-xl border border-orange-200/90 shadow-[0_14px_35px_-8px_rgba(234,88,12,0.22),0_2px_8px_rgba(0,0,0,0.04)] rounded-2xl p-2.5 sm:p-3 flex items-center gap-2.5 transition-transform hover:scale-103">
                <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-primary to-orange-500 text-white flex items-center justify-center flex-shrink-0 shadow-sm shadow-orange-500/30">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                    <path d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.381z" />
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex items-center justify-between gap-1">
                    <span class="text-xs font-bold text-gray-900 truncate" set:html={signalCard.title} />
                    {signalCard.badge && (
                      <span
                        class="text-sm font-extrabold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded-full border border-emerald-200/80"
                        set:html={signalCard.badge}
                      />
                    )}
                  </div>
                  {signalCard.text && (
                    <p class="text-xs text-gray-500 truncate mt-0.5 mb-0" set:html={signalCard.text} />
                  )}
                </div>
              </div>
            </div>
          )
        }

        {
          successCard && (
            <div class="absolute -bottom-3.5 sm:-bottom-5 -left-2 sm:-left-4 z-30 animate-float-slower max-w-[220px] sm:max-w-[245px] pointer-events-auto">
              <div class="bg-white/95 backdrop-blur-xl border border-gray-200/90 shadow-[0_14px_35px_-8px_rgba(15,23,42,0.14),0_2px_8px_rgba(0,0,0,0.04)] rounded-2xl p-2.5 sm:p-3 flex items-center gap-2.5 transition-transform hover:scale-103">
                <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white flex items-center justify-center flex-shrink-0 shadow-sm shadow-emerald-500/25">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div class="min-w-0 flex-1">
                  <span class="text-sm font-bold text-gray-900 block truncate" set:html={successCard.title} />
                  {successCard.text && (
                    <p class="text-xs text-gray-600 font-medium truncate mt-0.5 mb-0" set:html={successCard.text} />
                  )}
                </div>
              </div>
            </div>
          )
        }

        {
          image ? (
            <div class="relative w-full rounded-2xl bg-white border border-gray-200/90 shadow-[0_20px_50px_-12px_rgba(234,88,12,0.16),0_8px_20px_-4px_rgba(0,0,0,0.06)] overflow-hidden">
              <Media
                src={image}
                alt={imageAlt ?? ""}
                class="w-full h-auto max-h-[350px] xl:max-h-[410px] object-contain block"
              />
            </div>
          ) : (
            <!-- ULTRA-PREMIUM VERO SAAS DASHBOARD UI (Native Vector HTML/CSS) -->
            <div
              class="relative w-full rounded-2xl bg-white/95 backdrop-blur-xl border border-gray-200/90 shadow-[0_24px_50px_-12px_rgba(234,88,12,0.18),0_10px_25px_-5px_rgba(15,23,42,0.08),0_0_0_1px_rgba(0,0,0,0.04)] overflow-hidden transition-all duration-300"
            >
              <!-- 1. Window Chrome Header -->
              <div
                class="px-3.5 py-2.5 bg-gray-50/90 border-b border-gray-200/80 flex items-center justify-between gap-2"
              >
                <!-- Window Traffic Dots -->
                <div class="flex items-center gap-1.5">
                  <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F56] border border-[#E0443E]/50"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E] border border-[#DEA123]/50"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-[#27C93F] border border-[#1AAB29]/50"></span>
                </div>

                <!-- App URL Pill -->
                <div
                  class="flex items-center gap-1.5 px-3 py-1 rounded-md bg-white border border-gray-200/70 text-[11px] text-gray-500 font-mono shadow-2xs max-w-[220px] truncate"
                >
                  <svg
                    class="w-3 h-3 text-emerald-600 flex-shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    ></path>
                  </svg>
                  <span class="text-gray-700 font-medium truncate">app.vero.ai/pipeline</span>
                </div>

                <!-- Status Dot -->
                <div class="flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span class="text-[10px] font-semibold text-gray-500 hidden sm:inline">Engine Live</span>
                </div>
              </div>

              <!-- 2. Dashboard Body -->
              <div class="p-3 sm:p-4 bg-gradient-to-b from-white to-orange-50/20">
                <!-- Top 3 Metric Stat Cards -->
                <div class="grid grid-cols-3 gap-2 sm:gap-2.5 mb-3">
                  <!-- KPI 1 -->
                  <div class="p-2 sm:p-2.5 rounded-xl bg-orange-50/60 border border-orange-200/70 transition-all hover:bg-orange-50">
                    <span class="text-[10px] font-medium text-gray-500 block truncate">Pipeline Surge</span>
                    <div class="flex items-baseline gap-1 mt-0.5">
                      <span class="text-sm sm:text-base font-extrabold text-gray-900">$1.84M</span>
                      <span class="text-[9px] font-bold text-emerald-600">↑48%</span>
                    </div>
                  </div>

                  <!-- KPI 2 -->
                  <div class="p-2 sm:p-2.5 rounded-xl bg-white border border-gray-200/80 transition-all hover:border-orange-200">
                    <span class="text-[10px] font-medium text-gray-500 block truncate">Surging ICP</span>
                    <div class="flex items-baseline gap-1 mt-0.5">
                      <span class="text-sm sm:text-base font-extrabold text-gray-900">248</span>
                      <span class="text-[9px] font-bold text-primary">98% Fit</span>
                    </div>
                  </div>

                  <!-- KPI 3 -->
                  <div class="p-2 sm:p-2.5 rounded-xl bg-white border border-gray-200/80 transition-all hover:border-orange-200">
                    <span class="text-[10px] font-medium text-gray-500 block truncate">Auto Meetings</span>
                    <div class="flex items-baseline gap-1 mt-0.5">
                      <span class="text-sm sm:text-base font-extrabold text-gray-900">42</span>
                      <span class="text-[9px] font-bold text-emerald-600">+14 wk</span>
                    </div>
                  </div>
                </div>

                <!-- Two-Column Inner Workspace: Velocity Chart (Left) + High Intent Accounts (Right) -->
                <div class="grid grid-cols-1 sm:grid-cols-12 gap-2.5 items-stretch">
                  <!-- LEFT: Revenue Velocity Interactive Curve (5 Cols) -->
                  <div
                    class="sm:col-span-5 rounded-xl bg-white border border-gray-200/80 p-2.5 flex flex-col justify-between"
                  >
                    <div class="flex items-center justify-between mb-1.5">
                      <span class="text-[10px] font-bold text-gray-900 tracking-tight">Signal Surge Velocity</span>
                      <span class="text-[9px] font-semibold text-primary bg-orange-100/70 px-1 py-0.2 rounded">Live</span>
                    </div>

                    <!-- Glowing SVG Wave Chart -->
                    <div class="relative w-full h-24 my-auto">
                      <svg class="w-full h-full overflow-visible" viewBox="0 0 160 80" preserveAspectRatio="none">
                        <defs>
                          <linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#EA580C" stop-opacity="0.32" />
                            <stop offset="100%" stop-color="#EA580C" stop-opacity="0.0" />
                          </linearGradient>
                        </defs>
                        <!-- Grid lines -->
                        <line x1="0" y1="20" x2="160" y2="20" stroke="#f1f5f9" stroke-width="1" />
                        <line x1="0" y1="45" x2="160" y2="45" stroke="#f1f5f9" stroke-width="1" />
                        <line x1="0" y1="70" x2="160" y2="70" stroke="#f1f5f9" stroke-width="1" />
                        <!-- Area Fill -->
                        <path
                          d="M0,65 Q25,58 45,45 T90,30 T130,18 T160,8 L160,75 L0,75 Z"
                          fill="url(#chartGradient)"
                        />
                        <!-- Glowing Line -->
                        <path
                          d="M0,65 Q25,58 45,45 T90,30 T130,18 T160,8"
                          fill="none"
                          stroke="#EA580C"
                          stroke-width="2.5"
                          stroke-linecap="round"
                        />
                        <!-- Peak Pulse Indicator -->
                        <circle cx="160" cy="8" r="4" fill="#EA580C" />
                        <circle cx="160" cy="8" r="7" fill="#EA580C" opacity="0.3" class="animate-ping" />
                      </svg>
                    </div>

                    <div class="flex items-center justify-between pt-1 border-t border-gray-100 text-[9px] text-gray-400">
                      <span>Mon</span>
                      <span>Wed</span>
                      <span>Fri</span>
                      <span class="font-bold text-primary">Today</span>
                    </div>
                  </div>

                  <!-- RIGHT: Target Accounts Live Feed (7 Cols) -->
                  <div
                    class="sm:col-span-7 rounded-xl bg-white border border-gray-200/80 p-2.5 flex flex-col justify-between"
                  >
                    <div class="flex items-center justify-between mb-1.5">
                      <span class="text-[10px] font-bold text-gray-900 tracking-tight">Surging Target Accounts</span>
                      <span class="text-[9px] text-gray-400 font-medium">3 of 248</span>
                    </div>

                    <!-- Account Rows -->
                    <div class="space-y-1.5">
                      <!-- Row 1: Stripe -->
                      <div class="flex items-center justify-between gap-1.5 p-1.5 rounded-lg bg-orange-50/40 border border-orange-100/80 hover:bg-orange-50 transition-colors">
                        <div class="flex items-center gap-1.5 min-w-0">
                          <span class="w-5 h-5 rounded-md bg-[#635BFF] text-white flex items-center justify-center text-[10px] font-black flex-shrink-0">S</span>
                          <div class="min-w-0">
                            <span class="text-[11px] font-bold text-gray-900 block truncate leading-tight">Stripe</span>
                            <span class="text-[9px] text-gray-500 block truncate leading-tight">Fintech · 8.4k emp</span>
                          </div>
                        </div>
                        <div class="flex items-center gap-1 flex-shrink-0">
                          <span class="text-[9px] font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.2 rounded border border-emerald-200/80">98%</span>
                          <span class="text-[9px] font-semibold text-white bg-primary px-1.5 py-0.2 rounded">Sequence</span>
                        </div>
                      </div>

                      <!-- Row 2: Datadog -->
                      <div class="flex items-center justify-between gap-1.5 p-1.5 rounded-lg bg-gray-50/70 border border-gray-100 hover:bg-gray-100/60 transition-colors">
                        <div class="flex items-center gap-1.5 min-w-0">
                          <span class="w-5 h-5 rounded-md bg-[#7742BD] text-white flex items-center justify-center text-[10px] font-black flex-shrink-0">D</span>
                          <div class="min-w-0">
                            <span class="text-[11px] font-bold text-gray-900 block truncate leading-tight">Datadog</span>
                            <span class="text-[9px] text-gray-500 block truncate leading-tight">Observability · 4.2k</span>
                          </div>
                        </div>
                        <div class="flex items-center gap-1 flex-shrink-0">
