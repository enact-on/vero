---
/**
 * Centered statement above a row of big-number stats with dividers,
 * plus an optional footnote.
 *
 * Frontmatter:
 *   - type: stats-counter
 *     title: Revenue teams use Vero to turn fragmented activity ...
 *     stats:
 *       - { value: 2.8×, label: faster opportunity creation }
 *     note: Aggregate results across active Vero customers ...
 */
import { sectionClass, type BaseSectionProps } from "../../lib/sections";

interface Stat {
  value: string;
  label: string;
}

interface Props extends BaseSectionProps {
  title?: string;
  stats: Stat[];
  note?: string;
}

const { id, title, stats = [], note } = Astro.props;

const divider = "border-b lg:border-b-0 lg:border-r border-[#E3E2DD]";
const cellClass = (index: number) => {
  if (index === stats.length - 1) return "p-[30px_0px_20px_20px]";
  if (index === 0) return `p-[30px_20px_20px_0px] ${divider}`;
  return `p-[30px_20px_20px_20px] ${divider}`;
};
---

<section
  id={id}
  class={sectionClass("py-[80px] bg-white border-y border-[#E3E2DD]", Astro.props)}
>
  <div class="max-w-[1180px] mx-auto px-4 text-center">
    {
      title && (
        <h3
          data-animate="fade-up"
          class="text-[24px] font-[400] text-[#171719] tracking-[-0.0219em] max-w-[500px] mx-auto mb-[50px]"
          set:html={title}
        />
      )
    }

    <div class="grid grid-cols-2 lg:grid-cols-4 border-t border-[#E3E2DD] text-left">
      {
        stats.map((stat, index) => (
          <div data-animate="fade-up" class={cellClass(index)}>
            <div
              class="text-[42px] font-[700] text-[#171719] tracking-[-0.05em] leading-[63px]"
              set:html={stat.value}
            />
            <div class="text-[16px] text-[#69686E]" set:html={stat.label} />
          </div>
        ))
      }
    </div>
    {
      note && (
        <div
          data-animate="fade-up"
          class="mt-[27px] text-[#AAA9AD] text-[16px]"
          set:html={note}
        />
      )
    }
  </div>
</section>
