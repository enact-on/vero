---
/**
 * Dark numbered workflow strip (up to 6 steps in a row on desktop).
 *
 * Frontmatter:
 *   - type: workflow-steps
 *     eyebrow: "02 / ONE CONTINUOUS WORKFLOW"
 *     title: "From market signal to meaningful conversation."
 *     steps:
 *       - number: "01"            # optional, defaults to the step position
 *         icon: search            # Material Symbols name
 *         tone: purple            # purple | green
 *         title: Discover
 *         description: Find accounts showing real buying intent.
 */
import { sectionClass, type BaseSectionProps } from "../../lib/sections";

interface Step {
  number?: string;
  icon: string;
  tone?: "purple" | "green";
  title: string;
  description: string;
}

interface Props extends BaseSectionProps {
  eyebrow?: string;
  title: string;
  steps: Step[];
}

const { id, eyebrow, title, steps = [] } = Astro.props;

const tones = {
  purple: "bg-[#26243A] text-[#7465D4]",
  green: "bg-[#1F2D2A] text-[#459B71]",
};
---

<section
  id={id}
  class={sectionClass(
    "py-[80px] bg-[#1D1D22] text-white border-y border-[#37363C]",
    Astro.props,
  )}
>
  <div class="max-w-[1180px] mx-auto px-4 text-left">
    <div data-animate="fade-up" class="mb-14">
      {
        eyebrow && (
          <span
            class="text-[#85848D] font-[800] tracking-[0.105em] text-[12px] mb-4 block uppercase"
            set:html={eyebrow}
          />
        )
      }
      <h2 class="text-h2 text-white max-w-[600px]" set:html={title} />
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-y-12 lg:gap-y-0"
    >
      {
        steps.map((step, index) => (
          <div
            data-animate="fade-up"
            class={
              index < steps.length - 1
                ? "px-2 lg:px-6 relative border-b lg:border-b-0 lg:border-r border-[#37363C] last:border-0 pb-8 lg:pb-0 first:pl-0 last:pr-0"
                : "px-2 lg:px-6 relative last:border-0 pb-8 lg:pb-0 first:pl-0 last:pr-0"
            }
          >
            <div class="text-[#74737A] font-[400] text-[12px] mb-[40px]">
              {step.number ?? String(index + 1).padStart(2, "0")}
            </div>
            <div
              class={`w-[36px] h-[36px] rounded-[8px] ${tones[step.tone ?? "purple"]} flex items-center justify-center mb-6`}
            >
              <span class="material-symbols-outlined text-[18px]">
                {step.icon}
              </span>
            </div>
            <h3
              class="text-[16px] font-[500] text-[#EEEEEE] mb-2"
              set:html={step.title}
            />
            <p
              class="text-[#85848D] text-[13px] leading-[20px] pr-2"
              set:html={step.description}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
