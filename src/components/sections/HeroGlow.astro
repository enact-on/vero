---
/**
 * Centered hero with a pulsing purple glow, floating orbs, pill eyebrow,
 * two-line headline (second line highlighted), CTA buttons and a product image.
 *
 * Frontmatter:
 *   - type: hero-glow
 *     eyebrow: GTM Intelligence, Reimagined
 *     title: "Know who’s ready to buy."
 *     highlight: Before anyone else.        # optional, second line in primary colour
 *     description: Vero turns every market signal into ...
 *     buttons:
 *       - label: Start building pipeline
 *         href: "#"
 *         variant: primary                 # primary | secondary
 *         icon: arrow_forward              # optional Material Symbols name
 *       - label: Explore the platform
 *         href: "#"
 *         variant: secondary
 *     image: /src/assets/images/figma/hero-image.png
 *     imageAlt: Vero Dashboard
 */
import Media from "../ui/primitives/Media.astro";
import { sectionClass, type BaseSectionProps } from "../../lib/sections";

interface Button {
  label: string;
  href: string;
  variant?: "primary" | "secondary";
  icon?: string;
}

interface Props extends BaseSectionProps {
  eyebrow?: string;
  title: string;
  highlight?: string;
  description?: string;
  buttons?: Button[];
  image?: string;
  imageAlt?: string;
}

const {
  id,
  eyebrow,
  title,
  highlight,
  description,
  buttons = [],
  image,
  imageAlt,
} = Astro.props;

const buttonVariants = {
  primary:
    "px-6 py-3.5 bg-primary text-white font-[700] text-[16px] rounded-[7px] shadow-[0px_6px_18px_rgba(22,22,26,0.12)] hover:-translate-y-0.5 hover:shadow-[0px_10px_20px_rgba(22,22,26,0.2)] transition-all flex items-center justify-center gap-2",
  secondary:
    "px-6 py-3.5 bg-white text-[#171719] font-[700] text-[16px] border border-[#E3E2DD] rounded-[7px] hover:bg-[#F0EFEC] transition-all flex items-center justify-center",
};
---

<section
  id={id}
  class={sectionClass(
    "relative pt-12 md:pt-32 pb-16 px-4 md:px-8 max-w-[1280px] mx-auto flex flex-col items-center text-center",
    Astro.props,
  )}
>
  <div
    class="absolute top-[20%] left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-primary/20 blur-[100px] pointer-events-none rounded-full animate-pulse-glow z-2"
  >
  </div>

  <div
    class="absolute top-[30%] left-[10%] w-16 h-16 bg-gradient-to-br from-primary/30 to-transparent rounded-full blur-[10px] animate-float-slow pointer-events-none -z-10 hidden md:block"
  >
  </div>
  <div
    class="absolute top-[50%] right-[15%] w-24 h-24 bg-gradient-to-tl from-primary/20 to-transparent rounded-full blur-[12px] animate-float-slower pointer-events-none -z-10 hidden md:block"
  >
  </div>
  <div
    class="absolute top-[10%] right-[30%] w-8 h-8 bg-primary/30 rounded-full blur-[4px] animate-float-slow pointer-events-none -z-10 hidden md:block"
    style="animation-direction: reverse;"
  >
  </div>

  {
    eyebrow && (
      <div
        data-animate="fade-up"
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-[#E3E2DD] bg-white/40 backdrop-blur-sm mb-10 shadow-sm relative"
      >
        <span
          class="text-[12px] font-[800] tracking-[0.105em] text-[#77767C] uppercase"
          set:html={eyebrow}
        />
      </div>
    )
  }

  <h1
    data-animate="fade-up"
    class="text-[50px] md:text-[80px] font-[650] text-[#171719] tracking-[-0.066em] leading-[1.05] max-w-4xl mx-auto mb-6 relative"
  >
    <Fragment set:html={title} />
    {
      highlight && (
        <>
          <br />
          <span class="text-primary relative inline-block" set:html={highlight} />
        </>
      )
    }
  </h1>

  {
    description && (
      <p
        data-animate="fade-up"
        class="text-[18px] text-[#69686E] font-[400] max-w-[590px] mx-auto mb-10 leading-[28px] relative"
        set:html={description}
      />
    )
  }

  {
    buttons.length > 0 && (
      <div
        data-animate="fade-up"
        class="flex flex-wrap items-center justify-center gap-3 mb-16 w-full sm:w-auto relative"
      >
        {buttons.map((button) => (
          <a href={button.href} class={buttonVariants[button.variant ?? "primary"]}>
            <Fragment set:html={button.label} />
            {button.icon && (
              <span class="material-symbols-outlined text-[16px]">{button.icon}</span>
            )}
          </a>
        ))}
      </div>
    )
  }

  {
    image && (
      <div
        data-animate="fade-up"
        class="w-full max-w-[1061px] mx-auto relative group z-10"
      >
        <div class="absolute inset-0 bg-gradient-to-b from-primary/20 to-primary/5 blur-[80px] -z-10 rounded-[30px] animate-pulse-glow" />

        <Media
          src={image}
          alt={imageAlt ?? ""}
          class="w-full h-auto block rounded-2xl shadow-[0_30px_100px_-20px_rgba(101,88,217,0.3)] border border-[#E3E2DD]/60 relative z-10"
          quality="max"
        />
      </div>
    )
  }
</section>

<style is:global>
  @keyframes float-slow {
    0%,
    100% {
      transform: translateY(0) translateX(0);
    }
    50% {
      transform: translateY(-20px) translateX(10px);
    }
  }
  @keyframes float-slower {
    0%,
    100% {
      transform: translateY(0) translateX(0);
    }
    50% {
      transform: translateY(20px) translateX(-15px);
    }
  }
  @keyframes pulse-glow {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.05);
    }
  }

  .animate-float-slow {
    animation: float-slow 8s ease-in-out infinite;
  }
  .animate-float-slower {
    animation: float-slower 12s ease-in-out infinite;
  }
  .animate-pulse-glow {
    animation: pulse-glow 6s ease-in-out infinite;
  }
</style>
