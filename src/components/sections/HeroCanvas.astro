---
/**
 * Centered hero with grid + glow background, pill badge, headline, two CTAs
 * and a browser-framed product screenshot ("workspace canvas").
 *
 * Frontmatter:
 *   - type: hero-canvas
 *     badge:
 *       label: Vero Revenue Agents v2.4
 *       text: Built for Series A/B GTM
 *     title: 'Build, share, &amp; control <br class="hidden sm:inline" /> <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-orange-500 to-amber-500">autonomous revenue agents.</span>'
 *     description: Turn every raw market signal ...
 *     buttons:
 *       - { label: Get Started for free, href: "#", variant: primary }   # trailing arrow
 *       - { label: Book a demo, href: "#", variant: secondary }         # leading play icon
 *     browserUrl: vero.enacton.com
 *     image: /src/assets/images/astr-theme-hero.png
 *     imageAlt: Vero Dashboard
 */
import Media from "../ui/primitives/Media.astro";
import { sectionClass, type BaseSectionProps } from "../../lib/sections";

interface Button {
  label: string;
  href: string;
  variant?: "primary" | "secondary";
}

interface Props extends BaseSectionProps {
  badge?: { label: string; text?: string };
  title: string;
  description?: string;
  buttons?: Button[];
  browserUrl?: string;
  image: string;
  imageAlt?: string;
}

const {
  id,
  badge,
  title,
  description,
  buttons = [],
  browserUrl,
  image,
  imageAlt,
} = Astro.props;
---

<section
  id={id}
  class={sectionClass(
    "relative pt-24 pb-32 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto flex flex-col items-center text-center overflow-hidden",
    Astro.props,
  )}
>
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"
  >
  </div>
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-b from-primary/25 via-orange-400/15 to-transparent blur-3xl pointer-events-none -z-10 rounded-full opacity-70"
  >
  </div>

  {
    badge && (
      <div class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/40 backdrop-blur-sm border border-gray-200/60 shadow-sm mb-8 text-xs font-medium cursor-pointer hover:bg-white/60 transition-colors">
        <div class="flex items-center gap-1.5">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary/80 opacity-75" />
            <span class="relative inline-flex rounded-full h-2 w-2 bg-primary" />
          </span>
          <span class="text-gray-900" set:html={badge.label} />
        </div>
        {badge.text && <span class="text-gray-300">|</span>}
        {badge.text && <span class="text-gray-600" set:html={badge.text} />}
        <span class="text-gray-400 material-symbols-outlined text-[14px] group-hover:translate-x-0.5 transition-transform">
          arrow_forward
        </span>
      </div>
    )
  }

  <h1
    data-animate="fade-up"
    class="text-h1 text-gray-950 font-[650] tracking-[-0.05em] leading-[1.05] max-w-5xl mb-8"
    set:html={title}
  />

  {
    description && (
      <p
        class="font-body text-lg sm:text-xl text-gray-600 max-w-3xl mb-10 leading-relaxed font-normal"
        set:html={description}
      />
    )
  }

  {
    buttons.length > 0 && (
      <div class="flex flex-wrap items-center gap-4 mb-16 relative z-10">
        {buttons.map((button) =>
          (button.variant ?? "primary") === "primary" ? (
            <a
              class="inline-flex items-center justify-center px-7 py-3.5 rounded-xl bg-gray-900 text-white font-medium text-sm hover:bg-black transition-all shadow-[0_1px_2px_rgba(0,0,0,0.2),_inset_0_1px_0_rgba(255,255,255,0.1)] hover:shadow-[0_4px_12px_rgba(0,0,0,0.15),_inset_0_1px_0_rgba(255,255,255,0.1)] group"
              href={button.href}
            >
              <Fragment set:html={button.label} />
              <span class="material-symbols-outlined text-[18px] ml-1.5 group-hover:translate-x-0.5 transition-transform">
                arrow_forward
              </span>
            </a>
          ) : (
            <a
              class="inline-flex items-center justify-center px-7 py-3.5 rounded-xl bg-white border border-gray-200 text-gray-800 font-medium text-sm hover:bg-gray-50 hover:border-gray-300 transition-all shadow-sm group"
              href={button.href}
            >
              <span class="material-symbols-outlined text-[20px] mr-2 text-gray-400 group-hover:text-primary transition-colors">
                play_circle
              </span>
              <Fragment set:html={button.label} />
            </a>
          ),
        )}
      </div>
    )
  }

  <div
    class="relative w-full max-w-[1200px] mx-auto mt-4 z-0 group perspective-[2000px]"
  >
    <div
      class="absolute -inset-2 bg-gradient-to-r from-primary/20 via-orange-400/20 to-amber-400/20 rounded-[2.5rem] blur-2xl opacity-50 group-hover:opacity-70 transition-opacity duration-700"
    >
    </div>

    <div
      class="relative rounded-2xl sm:rounded-[2rem] bg-white/40 backdrop-blur-xl p-2 sm:p-4 border border-white/60 shadow-[0_8px_40px_rgba(0,0,0,0.08)] ring-1 ring-gray-900/5 transform transition-transform duration-700 hover:scale-[1.01]"
    >
      <div
        class="rounded-xl sm:rounded-[1.5rem] overflow-hidden border border-gray-200/80 bg-gray-50 shadow-inner"
      >
        <div
          class="h-10 border-b border-gray-200/80 bg-white/50 backdrop-blur-sm flex items-center px-4 gap-2"
        >
          <div class="w-3 h-3 rounded-full bg-gray-300 shadow-sm"></div>
          <div class="w-3 h-3 rounded-full bg-gray-300 shadow-sm"></div>
          <div class="w-3 h-3 rounded-full bg-gray-300 shadow-sm"></div>
          {
            browserUrl && (
              <div class="mx-auto text-[11px] font-medium text-gray-500 flex items-center gap-1.5 bg-white/60 px-3 py-1 rounded-md border border-gray-200/50 shadow-sm">
                <span class="material-symbols-outlined text-[12px]">lock</span>
                <Fragment set:html={browserUrl} />
              </div>
            )
          }
        </div>
        <Media src={image} alt={imageAlt} class="w-full h-auto block" />
      </div>
    </div>
  </div>
</section>
