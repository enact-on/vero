---
import Container from "../ui/layout/Container.astro";
import navigation from "../../config/navigation.json";
import siteConfig from "../../config/site.config";
import Logo from "../ui/primitives/Logo.astro";
---

<footer
  class="bg-surface border-t border-border pt-16 relative overflow-hidden flex flex-col"
>
  <Container>
    <div
      class="flex flex-col lg:flex-row lg:justify-between gap-12 mb-16 relative z-10"
    >
      <div class="max-w-[320px]">
        <Logo />
        <p class="mt-4 text-sm">
          {siteConfig.description}
        </p>
      </div>

      <div
        class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 lg:flex-1 gap-8"
      >
        {
          navigation.footer.map((section) => (
            <div>
              <h4 class="text-sm font-semibold mb-4">{section.title}</h4>
              <ul class="flex flex-col gap-3">
                {section.links.map((link) => (
                  <li>
                    <a
                      href={link.path}
                      class="text-text-secondary text-sm transition-colors hover:text-primary"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 pt-8 pb-4 border-t border-border relative z-10"
    >
      <p class="m-0 text-sm text-text-muted">
        &copy; {new Date().getFullYear()}
        {siteConfig.name} Inc. All rights reserved.
      </p>
      <div class="flex gap-6">
        <a
          href="/legal/privacy"
          class="text-sm text-text-muted hover:text-text-primary transition-colors"
          >Privacy Policy</a
        >
        <a
          href="/legal/terms"
          class="text-sm text-text-muted hover:text-text-primary transition-colors"
          >Terms of Service</a
        >
      </div>
    </div>
  </Container>

  <!-- Massive Bottom Text Effect -->
  <div
    class="absolute bottom-0 w-full flex justify-center items-end mt-8 leading-[0.75] pointer-events-none z-[1]"
  >
    <div
      class="absolute bottom-[-30%] left-1/2 -translate-x-1/2 w-[80%] h-full bg-[radial-gradient(ellipse_at_bottom,var(--color-primary-glow,rgba(234,88,12,0.2))_0%,transparent_60%)] -z-10 blur-[60px]"
    >
    </div>
    <span
      class="text-[clamp(6rem,20vw,24rem)] font-black uppercase tracking-[-0.04em] select-none bg-[linear-gradient(to_bottom,transparent_20%,rgba(234,88,12,0.08)_100%)] [-webkit-background-clip:text] [-webkit-text-fill-color:transparent]"
    >
      {siteConfig.name}
    </span>
  </div>
</footer>
