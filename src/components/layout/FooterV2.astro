---
// FooterV2.astro
import Logo from '../ui/primitives/Logo.astro';
import navigation from '../../config/navigation.json';
import siteConfig from '../../config/site.config';
---

    <footer
      class="bg-gray-50 border-t border-gray-200 pt-16 pb-12 text-xs text-gray-600"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-8 mb-12">
          {
            navigation.footer.map((section) => (
              <div>
                <h4 class="font-bold text-gray-900 uppercase tracking-wider text-[11px] mb-3">
                  {section.title}
                </h4>
                <ul class="space-y-2">
                  {section.links.map((link) => (
                    <li>
                      <a
                        class="hover:text-gray-950 transition-colors"
                        href={link.path}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <!-- Bottom Line -->
        <div
          class="pt-8 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-4"
        >
          <div class="flex items-center gap-2">
            <div class="flex items-center gap-1">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span class="w-2 h-2 rounded-full bg-primary"></span>
              <span class="w-2 h-2 rounded-full bg-pink-500"></span>
            </div>
            <span class="font-bold text-gray-900">{siteConfig.name}</span>
            <span class="text-gray-400"
              >&copy; {new Date().getFullYear()} {siteConfig.name} Technologies Inc. All rights
              reserved.</span
            >
          </div>
          <div class="flex items-center gap-4 text-gray-500 text-xs font-code">
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span> All systems
              operational
            </span>
          </div>
        </div>
      </div>
    </footer>