---
/**
 * Image that accepts a markdown path. Local `assets/` images go through
 * astro:assets <Image>; public paths and URLs fall back to a plain <img>.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { resolveImage } from "../../../lib/sections";

interface Props {
  src: string | ImageMetadata;
  alt?: string;
  [key: string]: any;
}

const { src, alt = "", ...rest } = Astro.props;
const resolved = resolveImage(src);
---

{
  typeof resolved === "string" ? (
    <img src={resolved} alt={alt} {...rest} />
  ) : (
    <Image src={resolved!} alt={alt} {...rest} />
  )
}
