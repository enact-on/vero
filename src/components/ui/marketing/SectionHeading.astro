---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'center' } = Astro.props;

const alignClasses = align === 'center' ? 'items-center text-center' : 'items-start text-left';
---

<div class={`flex flex-col mb-12 ${alignClasses}`}>
  {eyebrow && <span class="text-eyebrow text-primary font-semibold text-sm tracking-wider uppercase mb-3">{eyebrow}</span>}
  <h2 class="text-h2 mb-4">{title}</h2>
  {description && <p class="text-body-large max-w-[700px] m-0 text-text-secondary">{description}</p>}
</div>
