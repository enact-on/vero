---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";

// Figma Images
import heroImage from "../assets/images/figma/hero-image.png";
import imgFeature1 from "../assets/images/figma/feature-1.png";
import imgDiscover from "../assets/images/figma/image-4.png";
import imgUnderstand from "../assets/images/figma/feature-2.png";
import imgAct from "../assets/images/figma/feature-3.png";

// Missed Sections Images
import imgSales from "../assets/images/figma/card-sales.png";
import imgMarketing from "../assets/images/figma/card-marketing.png";
import imgRevops from "../assets/images/figma/card-revops.png";
import imgBannerPipeline from "../assets/images/figma/banner-pipeline.png";
import imgIntegrations from "../assets/images/figma/integrations.png";
import ctaBg from "../assets/images/cta-bg.png";
---

<BaseLayout
  headerStyle="v1"
  footerStyle="v1"
  title="Vero — Premium GTM Intelligence"
>
  <!-- Main Wrapper with Figma's exact light background -->
  <main
    class="w-full bg-[#FAFAF8] text-[#171719] font-['Manrope'] overflow-hidden"
  >
    <!-- 1. HERO SECTION -->
    <section
      class="relative pt-12 md:pt-32 pb-16 px-4 md:px-8 max-w-[1280px] mx-auto flex flex-col items-center text-center"
    >
      <!-- Glow Decor -->
      <div
        class="absolute top-[20%] left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-primary/20 blur-[100px] pointer-events-none rounded-full animate-pulse-glow z-2"
      >
      </div>

      <!-- Floating Elements -->
      <div
        class="absolute top-[30%] left-[10%] w-16 h-16 bg-gradient-to-br from-primary/30 to-transparent rounded-full blur-[10px] animate-float-slow pointer-events-none -z-10 hidden md:block"
      >
      </div>
      <div
        class="absolute top-[50%] right-[15%] w-24 h-24 bg-gradient-to-tl from-primary/20 to-transparent rounded-full blur-[12px] animate-float-slower pointer-events-none -z-10 hidden md:block"
      >
      </div>
      <div
        class="absolute top-[10%] right-[30%] w-8 h-8 bg-primary/30 rounded-full blur-[4px] animate-float-slow pointer-events-none -z-10 hidden md:block"
        style="animation-direction: reverse;"
      >
      </div>

      <!-- Pill -->
      <div
        data-animate="fade-up"
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-[#E3E2DD] bg-white/40 backdrop-blur-sm mb-10 shadow-sm relative"
      >
        <span
          class="text-[12px] font-[800] tracking-[0.105em] text-[#77767C] uppercase"
          >GTM Intelligence, Reimagined</span
        >
      </div>

      <!-- Headline -->
      <h1
        data-animate="fade-up"
        class="text-[50px] md:text-[80px] font-[650] text-[#171719] tracking-[-0.066em] leading-[1.05] max-w-4xl mx-auto mb-6 relative"
      >
        Know who’s ready to buy. <br />
        <span class="text-primary relative inline-block">
          Before anyone else.
        </span>
      </h1>

      <!-- Description -->
      <p
        data-animate="fade-up"
        class="text-[18px] text-[#69686E] font-[400] max-w-[590px] mx-auto mb-10 leading-[28px] relative"
      >
        Vero turns every market signal into a clear next move—so your revenue
        team can find demand, reach the right people, and build pipeline with
        precision.
      </p>

      <!-- CTA Buttons -->
      <div
        data-animate="fade-up"
        class="flex flex-wrap items-center justify-center gap-3 mb-16 w-full sm:w-auto relative"
      >
        <a
          href="#"
          class="px-6 py-3.5 bg-primary text-white font-[700] text-[16px] rounded-[7px] shadow-[0px_6px_18px_rgba(22,22,26,0.12)] hover:-translate-y-0.5 hover:shadow-[0px_10px_20px_rgba(22,22,26,0.2)] transition-all flex items-center justify-center gap-2"
        >
          Start building pipeline
          <span class="material-symbols-outlined text-[16px]"
            >arrow_forward</span
          >
        </a>
        <a
          href="#"
          class="px-6 py-3.5 bg-white text-[#171719] font-[700] text-[16px] border border-[#E3E2DD] rounded-[7px] hover:bg-[#F0EFEC] transition-all flex items-center justify-center"
        >
          Explore the platform
        </a>
      </div>

      <!-- Hero Image -->
      <div
        data-animate="fade-up"
        class="w-full max-w-[1061px] mx-auto relative group z-10"
      >
        <!-- Intense purple shadow behind the image -->
        <div
          class="absolute inset-0 bg-gradient-to-b from-primary/20 to-primary/5 blur-[80px] -z-10 rounded-[30px] animate-pulse-glow"
        >
        </div>

        <Image
          src={heroImage}
          alt="Vero Dashboard"
          class="w-full h-auto block rounded-2xl shadow-[0_30px_100px_-20px_rgba(101,88,217,0.3)] border border-[#E3E2DD]/60 relative z-10"
          quality="max"
        />
      </div>
    </section>

    <!-- 2. SOCIAL PROOF LOGOS -->
    <section
      class="border-y border-[#E3E2DD] bg-white pt-[40px] pb-[50px] overflow-hidden"
    >
      <div class="text-center mb-8 px-4">
        <p
          class="text-[12px] font-[800] tracking-[0.1em] text-[#99989D] uppercase"
        >
          Trusted by modern revenue teams at
        </p>
      </div>
      <div class="flex w-full overflow-hidden relative group">
        <!-- Marquee Track 1 -->
        <div
          class="flex shrink-0 gap-[100px] px-[50px] animate-marquee opacity-80 grayscale group-hover:grayscale-0 transition-all duration-500"
        >
          <span class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449]"
            >VERTEX</span
          >
          <span
            class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449] italic"
            >arcwise</span
          >
          <span class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449]"
            >MONO</span
          >
          <span class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449]"
            >NORTHSTAR</span
          >
          <span
            class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449] italic"
            >Plain</span
          >
          <span class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449]"
            >Layers</span
          >
          <!-- Duplicated list to ensure it's wide enough -->
          <span class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449]"
            >VERTEX</span
          >
          <span
            class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449] italic"
            >arcwise</span
          >
          <span class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449]"
            >MONO</span
          >
          <span class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449]"
            >NORTHSTAR</span
          >
          <span
            class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449] italic"
            >Plain</span
          >
          <span class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449]"
            >Layers</span
          >
        </div>
        <!-- Marquee Track 2 -->
        <div
          class="flex shrink-0 gap-[100px] px-[50px] animate-marquee opacity-80 grayscale group-hover:grayscale-0 transition-all duration-500"
          aria-hidden="true"
        >
          <span class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449]"
            >VERTEX</span
          >
          <span
            class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449] italic"
            >arcwise</span
          >
          <span class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449]"
            >MONO</span
          >
          <span class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449]"
            >NORTHSTAR</span
          >
          <span
            class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449] italic"
            >Plain</span
          >
          <span class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449]"
            >Layers</span
          >
          <!-- Duplicated list to ensure it's wide enough -->
          <span class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449]"
            >VERTEX</span
          >
          <span
            class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449] italic"
            >arcwise</span
          >
          <span class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449]"
            >MONO</span
          >
          <span class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449]"
            >NORTHSTAR</span
          >
          <span
            class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449] italic"
            >Plain</span
          >
          <span class="text-[28px] font-[800] tracking-[-0.04em] text-[#454449]"
            >Layers</span
          >
        </div>
      </div>
    </section>

    <!-- 3. FEATURE 1: INTELLIGENCE -->
    <section class="py-[80px] bg-[#FAFAF8] relative overflow-hidden">
      <div class="max-w-[1180px] mx-auto px-4">
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-[60px] items-start mb-16"
        >
          <div data-animate="fade-up">
            <span
              class="text-[#77767C] font-[800] tracking-[0.105em] text-[12px] mb-4 block uppercase"
              >01 / INTELLIGENCE</span
            >
            <h2 class="text-h2 text-[#171719]">
              Know where the opportunity is before your competitors do.
            </h2>
          </div>
          <div data-animate="fade-up" class="pt-2">
            <p
              class="text-[18px] text-[#737278] font-[400] leading-[28px] text-right lg:text-left"
            >
              Vero connects scattered buying signals into one complete,
              continuously updated view of every account in your market.
            </p>
          </div>
        </div>

        <div
          data-animate="fade-up"
          class="w-full rounded-[16px] overflow-hidden shadow-xl"
        >
          <Image
            src={imgFeature1}
            alt="Intelligence Dashboard"
            class="w-full h-auto block"
            quality="max"
          />
        </div>
      </div>
    </section>

    <!-- 4. WORKFLOW GRID (DARK SECTION) -->
    <section
      class="py-[80px] bg-[#1D1D22] text-white border-y border-[#37363C]"
    >
      <div class="max-w-[1180px] mx-auto px-4 text-left">
        <div data-animate="fade-up" class="mb-14">
          <span
            class="text-[#85848D] font-[800] tracking-[0.105em] text-[12px] mb-4 block uppercase"
            >02 / ONE CONTINUOUS WORKFLOW</span
          >
          <h2 class="text-h2 text-white max-w-[600px]">
            From market signal to meaningful conversation.
          </h2>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-y-12 lg:gap-y-0"
        >
          <!-- Step 1 -->
          <div
            data-animate="fade-up"
            class="px-2 lg:px-6 relative border-b lg:border-b-0 lg:border-r border-[#37363C] last:border-0 pb-8 lg:pb-0 first:pl-0 last:pr-0"
          >
            <div class="text-[#74737A] font-[400] text-[12px] mb-[40px]">
              01
            </div>
            <!-- Arrow on border -->
            <!-- <div class="absolute -right-[7px] top-[0px] text-[#4F4E54] text-[14px] bg-[#1D1D22] py-1 leading-none hidden lg:block">
              &rarr;
            </div> -->
            <div
              class="w-[36px] h-[36px] rounded-[8px] bg-[#26243A] text-[#7465D4] flex items-center justify-center mb-6"
            >
              <span class="material-symbols-outlined text-[18px]">search</span>
            </div>
            <h3 class="text-[16px] font-[500] text-[#EEEEEE] mb-2">Discover</h3>
            <p class="text-[#85848D] text-[13px] leading-[20px] pr-2">
              Find accounts showing real buying intent.
            </p>
          </div>

          <!-- Step 2 -->
          <div
            data-animate="fade-up"
            class="px-2 lg:px-6 relative border-b lg:border-b-0 lg:border-r border-[#37363C] last:border-0 pb-8 lg:pb-0 first:pl-0 last:pr-0"
          >
            <div class="text-[#74737A] font-[400] text-[12px] mb-[40px]">
              02
            </div>
            <!-- Arrow on border -->
            <!-- <div class="absolute -right-[7px] top-[0px] text-[#4F4E54] text-[14px] bg-[#1D1D22] py-1 leading-none hidden lg:block">
              &rarr;
            </div> -->
            <div
              class="w-[36px] h-[36px] rounded-[8px] bg-[#26243A] text-[#7465D4] flex items-center justify-center mb-6"
            >
              <span class="material-symbols-outlined text-[18px]"
                >receipt_long</span
              >
            </div>
            <h3 class="text-[16px] font-[500] text-[#EEEEEE] mb-2">Enrich</h3>
            <p class="text-[#85848D] text-[13px] leading-[20px] pr-2">
              Complete every account and contact record.
            </p>
          </div>

          <!-- Step 3 -->
          <div
            data-animate="fade-up"
            class="px-2 lg:px-6 relative border-b lg:border-b-0 lg:border-r border-[#37363C] last:border-0 pb-8 lg:pb-0 first:pl-0 last:pr-0"
          >
            <div class="text-[#74737A] font-[400] text-[12px] mb-[40px]">
              03
            </div>
            <!-- Arrow on border -->
            <!-- <div class="absolute -right-[7px] top-[0px] text-[#4F4E54] text-[14px] bg-[#1D1D22] py-1 leading-none hidden lg:block">
              &rarr;
            </div> -->
            <div
              class="w-[36px] h-[36px] rounded-[8px] bg-[#1F2D2A] text-[#459B71] flex items-center justify-center mb-6"
            >
              <span class="material-symbols-outlined text-[18px]"
                >temp_preferences_custom</span
              >
            </div>
            <h3 class="text-[16px] font-[500] text-[#EEEEEE] mb-2">
              Understand
            </h3>
            <p class="text-[#85848D] text-[13px] leading-[20px] pr-2">
              Turn activity into a clear buying narrative.
            </p>
          </div>

          <!-- Step 4 -->
          <div
            data-animate="fade-up"
            class="px-2 lg:px-6 relative border-b lg:border-b-0 lg:border-r border-[#37363C] last:border-0 pb-8 lg:pb-0 first:pl-0 last:pr-0"
          >
            <div class="text-[#74737A] font-[400] text-[12px] mb-[40px]">
              04
            </div>
            <!-- Arrow on border -->
            <!-- <div class="absolute -right-[7px] top-[0px] text-[#4F4E54] text-[14px] bg-[#1D1D22] py-1 leading-none hidden lg:block">
              &rarr;
            </div> -->
            <div
              class="w-[36px] h-[36px] rounded-[8px] bg-[#26243A] text-[#7465D4] flex items-center justify-center mb-6"
            >
              <span class="material-symbols-outlined text-[18px]">group</span>
            </div>
            <h3 class="text-[16px] font-[500] text-[#EEEEEE] mb-2">
              Personalize
            </h3>
            <p class="text-[#85848D] text-[13px] leading-[20px] pr-2">
              Create relevant messaging for each person.
            </p>
          </div>

          <!-- Step 5 -->
          <div
            data-animate="fade-up"
            class="px-2 lg:px-6 relative border-b lg:border-b-0 lg:border-r border-[#37363C] last:border-0 pb-8 lg:pb-0 first:pl-0 last:pr-0"
          >
            <div class="text-[#74737A] font-[400] text-[12px] mb-[40px]">
              05
            </div>
            <!-- Arrow on border -->
            <!-- <div class="absolute -right-[7px] top-[0px] text-[#4F4E54] text-[14px] bg-[#1D1D22] py-1 leading-none hidden lg:block">
              &rarr;
            </div> -->
            <div
              class="w-[36px] h-[36px] rounded-[8px] bg-[#1F2D2A] text-[#459B71] flex items-center justify-center mb-6"
            >
              <span class="material-symbols-outlined text-[18px]">bolt</span>
            </div>
            <h3 class="text-[16px] font-[500] text-[#EEEEEE] mb-2">Engage</h3>
            <p class="text-[#85848D] text-[13px] leading-[20px] pr-2">
              Activate coordinated plays across channels.
            </p>
          </div>

          <!-- Step 6 -->
          <div
            data-animate="fade-up"
            class="px-2 lg:px-6 relative last:border-0 pb-8 lg:pb-0 first:pl-0 last:pr-0"
          >
            <div class="text-[#74737A] font-[400] text-[12px] mb-[40px]">
              06
            </div>
            <div
              class="w-[36px] h-[36px] rounded-[8px] bg-[#26243A] text-[#7465D4] flex items-center justify-center mb-6"
            >
              <span class="material-symbols-outlined text-[18px]">code</span>
            </div>
            <h3 class="text-[16px] font-[500] text-[#EEEEEE] mb-2">Sync</h3>
            <p class="text-[#85848D] text-[13px] leading-[20px] pr-2">
              Keep your systems and teams aligned.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. FEATURE 2 & 3: DISCOVER, UNDERSTAND, ACT -->
    <section class="py-[80px] bg-[#FAFAF8]">
      <div class="max-w-[1180px] mx-auto px-4 flex flex-col gap-[100px]">
        <!-- Discover -->
        <div
          class="grid grid-cols-1 lg:grid-cols-[420px_1fr] gap-10 md:gap-[100px] items-center"
        >
          <div data-animate="fade-up">
            <span
              class="text-[#77767C] font-[800] tracking-[0.105em] text-[12px] mb-[39px] block uppercase"
              >DISCOVER</span
            >
            <h3 class="text-h2 text-[#171719] mb-[20px]">
              See the market move in real time.
            </h3>
            <p
              class="text-[16px] text-[#737278] font-[400] leading-[24px] mb-[30px]"
            >
              Track the signals that reveal active demand across every account
              in your market—not just the companies already in your CRM.
            </p>
            <a
              href="#"
              class="inline-flex items-center gap-2 text-primary font-[800] text-[14px] border-b border-primary/30 pb-1 hover:border-primary transition-all"
            >
              Explore account discovery <span
                class="material-symbols-outlined text-[16px]"
                >arrow_forward</span
              >
            </a>
          </div>
          <div data-animate="fade-up" class="justify-self-end w-full">
            <Image
              src={imgDiscover}
              alt="Discover Dashboard"
              class="w-full h-auto rounded-[16px] shadow-lg hover:scale-[1.02] transition-transform duration-500"
              quality="max"
            />
          </div>
        </div>

        <!-- Understand -->
        <div
          class="grid grid-cols-1 lg:grid-cols-[1fr_420px] gap-[100px] items-center"
        >
          <div data-animate="fade-up" class="w-full">
            <Image
              src={imgUnderstand}
              alt="Understand Dashboard"
              class="w-full h-auto rounded-[16px] shadow-lg hover:scale-[1.02] transition-transform duration-500"
              quality="max"
            />
          </div>
          <div data-animate="fade-up">
            <span
              class="text-[#77767C] font-[800] tracking-[0.105em] text-[12px] mb-[39px] block uppercase"
              >UNDERSTAND</span
            >
            <h3 class="text-h2 text-[#171719] mb-[20px]">
              Know the story behind every signal.
            </h3>
            <p
              class="text-[16px] text-[#737278] font-[400] leading-[24px] mb-[30px]"
            >
              Vero AI connects people, events, and behavior into an account
              narrative your team can trust—and act on immediately.
            </p>
            <a
              href="#"
              class="inline-flex items-center gap-2 text-primary font-[800] text-[14px] border-b border-primary/30 pb-1 hover:border-primary transition-all"
            >
              Explore account intelligence <span
                class="material-symbols-outlined text-[16px]"
                >arrow_forward</span
              >
            </a>
          </div>
        </div>

        <!-- Act -->
        <div
          class="grid grid-cols-1 lg:grid-cols-[420px_1fr] gap-10 md:gap-[100px] items-center"
        >
          <div data-animate="fade-up">
            <span
              class="text-[#77767C] font-[800] tracking-[0.105em] text-[12px] mb-[39px] block uppercase"
              >ACT</span
            >
            <h3 class="text-h2 text-[#171719] mb-[20px]">
              Move at the moment that matters.
            </h3>
            <p
              class="text-[16px] text-[#737278] font-[400] leading-[24px] mb-[30px]"
            >
              Turn intelligence into coordinated action across your GTM stack,
              with the right message, owner, and channel built into every play.
            </p>
            <a
              href="#"
              class="inline-flex items-center gap-2 text-primary font-[800] text-[14px] border-b border-primary/30 pb-1 hover:border-primary transition-all"
            >
              Explore activation <span
                class="material-symbols-outlined text-[16px]"
                >arrow_forward</span
              >
            </a>
          </div>
          <div data-animate="fade-up" class="justify-self-end w-full">
            <Image
              src={imgAct}
              alt="Act Dashboard"
              class="w-full h-auto rounded-[16px] shadow-lg hover:scale-[1.02] transition-transform duration-500"
              quality="max"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 6. AI AGENTS SECTION (DARK SECTION) -->
    <section class="py-12 lg:py-24 bg-[#1D1D22] text-white">
      <div class="max-w-[1180px] mx-auto px-4">
        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-[50px] items-center mb-[75px]"
        >
          <div data-animate="fade-up">
            <span
              class="text-[#85848D] font-[800] tracking-[0.105em] text-[12px] mb-4 block uppercase"
              >03 / AI AGENTS</span
            >
            <h2 class="text-h2 text-white">
              More intelligence.<br />Less manual work.
            </h2>
          </div>
          <div data-animate="fade-up" class="lg:text-right">
            <p
              class="text-[16px] text-[#A09FA7] font-[400] leading-[24px] max-w-[565px] ml-auto"
            >
              Deploy purpose-built agents that research, reason, and
              create—while your team stays in control.
            </p>
          </div>
        </div>

        <div
          class="grid grid-cols-1 lg:grid-cols-[442px_1fr] gap-[75px] items-center"
        >
          <div
            data-animate="fade-up"
            class="flex flex-col gap-0"
            id="agent-tabs-container"
          >
            <!-- Agent 1 -->
            <button
              class="agent-tab text-left py-6 border-t border-primary flex flex-col gap-4 w-full transition-colors duration-300 group"
              data-index="0"
            >
              <div
                class="tab-icon w-[30px] h-[30px] rounded-[8px] bg-[#36314C] flex items-center justify-center text-white font-mono text-xs font-bold shrink-0 transition-colors"
              >
                01
              </div>
              <div>
                <h4
                  class="tab-title text-[16px] font-[700] text-white mb-2 transition-colors"
                >
                  Intelligence with AI & automation
                </h4>
                <p
                  class="tab-desc text-[#EEEEEE] text-[16px] font-[400] leading-relaxed transition-colors"
