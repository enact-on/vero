<script>
  function initFAQs() {
    const faqItems = document.querySelectorAll(".faq-item");
    faqItems.forEach((item) => {
      const button = item.querySelector(".faq-button");
      const icon = item.querySelector(".faq-icon");
      const content = item.querySelector(".faq-content");

      // clone to avoid double event listeners during HMR
      const newButton = button.cloneNode(true);
      button.parentNode.replaceChild(newButton, button);

      newButton.addEventListener("click", () => {
        const isOpen = item.classList.contains("is-open");
        if (!isOpen) {
          item.classList.add("is-open");
          icon.textContent = "−";
          content.style.gridTemplateRows = "1fr";
        } else {
          item.classList.remove("is-open");
          icon.textContent = "+";
          content.style.gridTemplateRows = "0fr";
        }
      });
    });
  }

  function initAgentSlider() {
    const tabs = document.querySelectorAll(".agent-tab");
    const panels = document.querySelectorAll(".agent-panel");
    let currentIndex = 0;
    let autoPlayInterval;

    if (!tabs.length || !panels.length) return;

    function switchTab(index) {
      // Update tabs
      tabs.forEach((tab, i) => {
        const icon = tab.querySelector(".tab-icon");
        const title = tab.querySelector(".tab-title");
        const desc = tab.querySelector(".tab-desc");

        if (i === index) {
          tab.classList.remove("border-[#37363C]");
          tab.classList.add("border-primary");
          icon.classList.remove("bg-[#28272D]", "text-[#77767E]");
          icon.classList.add("bg-[#36314C]", "text-white");
          title.classList.remove("text-[#77767E]");
          title.classList.add("text-white");
          desc.classList.remove("text-[#77767E]");
          desc.classList.add("text-[#EEEEEE]");
        } else {
          tab.classList.remove("border-primary");
          tab.classList.add("border-[#37363C]");
          icon.classList.remove("bg-[#36314C]", "text-white");
          icon.classList.add("bg-[#28272D]", "text-[#77767E]");
          title.classList.remove("text-white");
          title.classList.add("text-[#77767E]");
          desc.classList.remove("text-[#EEEEEE]");
          desc.classList.add("text-[#77767E]");
        }
      });

      // Update panels
      panels.forEach((panel, i) => {
        if (i === index) {
          panel.classList.remove(
            "opacity-0",
            "pointer-events-none",
            "z-0",
            "scale-95",
          );
          panel.classList.add("opacity-100", "z-10", "scale-100");
        } else {
          panel.classList.remove("opacity-100", "z-10", "scale-100");
          panel.classList.add(
            "opacity-0",
            "pointer-events-none",
            "z-0",
            "scale-95",
          );
        }
      });

      currentIndex = index;
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayInterval = setInterval(() => {
        let nextIndex = (currentIndex + 1) % tabs.length;
        switchTab(nextIndex);
      }, 5000); // 5 seconds
    }

    function stopAutoPlay() {
      if (autoPlayInterval) clearInterval(autoPlayInterval);
    }

    // Attach events without cloning so tabs reference remains valid
    tabs.forEach((tab, i) => {
      tab.onclick = () => {
        switchTab(i);
        startAutoPlay(); // Restart timer on manual click
      };
    });

    // Start
    switchTab(0);
    startAutoPlay();
  }

  function initTestimonialSlider() {
    const slides = document.querySelectorAll(".testimonial-slide");
    const dots = document.querySelectorAll(".test-dot");
    const prevBtn = document.querySelector(".test-prev");
    const nextBtn = document.querySelector(".test-next");
    if (!slides.length) return;

    let currentIndex = 0;
    let autoPlay;

    function goToSlide(index) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;

      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.remove(
            "opacity-0",
            "z-0",
            "translate-x-8",
            "-translate-x-8",
            "pointer-events-none",
          );
          slide.classList.add("opacity-100", "z-10", "translate-x-0");
        } else {
          slide.classList.remove("opacity-100", "z-10", "translate-x-0");
          slide.classList.add("opacity-0", "z-0", "pointer-events-none");
          if (i < index) {
            slide.classList.add("-translate-x-8");
            slide.classList.remove("translate-x-8");
          } else {
            slide.classList.add("translate-x-8");
            slide.classList.remove("-translate-x-8");
          }
        }
      });

      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.remove("bg-[#D4D3CD]", "hover:bg-[#A9A8A2]");
          dot.classList.add("bg-[#171719]");
        } else {
          dot.classList.remove("bg-[#171719]");
          dot.classList.add("bg-[#D4D3CD]", "hover:bg-[#A9A8A2]");
        }
      });

      currentIndex = index;
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }
    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function startAutoPlay() {
      if (autoPlay) clearInterval(autoPlay);
      autoPlay = setInterval(nextSlide, 6000);
    }

    if (prevBtn)
      prevBtn.onclick = () => {
        prevSlide();
        startAutoPlay();
      };
    if (nextBtn)
      nextBtn.onclick = () => {
        nextSlide();
        startAutoPlay();
      };

    dots.forEach((dot, i) => {
      dot.onclick = () => {
        goToSlide(i);
        startAutoPlay();
      };
    });

    goToSlide(0);
    startAutoPlay();
  }

  // Support both standard DOM load and Astro's ViewTransitions page load
  document.addEventListener("DOMContentLoaded", () => {
    initFAQs();
    initAgentSlider();
    initTestimonialSlider();
  });
  document.addEventListener("astro:page-load", () => {
    initFAQs();
    initAgentSlider();
    initTestimonialSlider();
  });
</script>
