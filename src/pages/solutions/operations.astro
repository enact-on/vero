---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/layout/Container.astro';
import Analytics from '../../components/sections/Analytics.astro';
import IntegrationUI from '../../components/sections/IntegrationUI.astro';
import Button from '../../components/ui/primitives/Button.astro';
---

<BaseLayout headerStyle="v1" footerStyle="v1" showAnnouncement={true} title="Vero for RevOps" description="Measure, connect, and optimize your entire GTM funnel.">
  <section class="pt-32 pb-20 bg-gray-50 text-center">
    <Container>
      <span class="text-eyebrow mb-4 block">VERO FOR REVOPS</span>
      <h1 class="text-display mb-6 max-w-4xl mx-auto">Total visibility into what's working.</h1>
      <p class="text-body-large mb-10 max-w-2xl mx-auto">
        Connect your data silos. Vero gives RevOps teams a single pane of glass to measure outbound ROI, track data flow, and ensure rep compliance.
      </p>
      <Button href="/pricing" variant="primary" size="large">Start free trial</Button>
    </Container>
  </section>

  <section class="py-32 bg-white">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-h2 mb-6">Prove your outbound ROI.</h2>
          <p class="text-body-large mb-8">
            Stop guessing which plays generate pipeline. Vero tracks every intent signal through to closed-won revenue, so you know exactly where to invest your resources.
          </p>
        </div>
        <div>
          <Analytics />
        </div>
      </div>
    </Container>
  </section>

  <section class="py-32 bg-gray-50">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="order-1 lg:order-2">
          <h2 class="text-h2 mb-6">Connect your messy data stack.</h2>
          <p class="text-body-large mb-8">
            Keep your CRM clean. Vero natively integrates with Salesforce and HubSpot, automatically enriching accounts and deduplicating contacts before they hit your database.
          </p>
        </div>
        <div class="order-2 lg:order-1 p-8 rounded-xl bg-white border border-gray-200">
          <IntegrationUI />
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
