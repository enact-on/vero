---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/layout/Container.astro';
import AccountIntelligence from '../../components/sections/AccountIntelligence.astro';
import ProspectIntelligence from '../../components/sections/ProspectIntelligence.astro';
import Button from '../../components/ui/primitives/Button.astro';
---

<BaseLayout headerStyle="v1" footerStyle="v1" showAnnouncement={true} title="Vero for Sales" description="Close more deals with AI-powered sales intelligence.">
  <section class="pt-32 pb-20 bg-gray-50 text-center">
    <Container>
      <span class="text-eyebrow mb-4 block">VERO FOR SALES</span>
      <h1 class="text-display mb-6 max-w-4xl mx-auto">Stop prospecting. Start selling.</h1>
      <p class="text-body-large mb-10 max-w-2xl mx-auto">
        Give your account executives the ultimate unfair advantage. Vero feeds your CRM with high-intent accounts and the exact buying committee members you need to close them.
      </p>
      <Button href="/pricing" variant="primary" size="large">Start free trial</Button>
    </Container>
  </section>

  <section class="py-32 bg-white">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-h2 mb-6">Focus on the 5% ready to buy.</h2>
          <p class="text-body-large mb-8">
            Don't waste time on cold accounts. Account Intelligence monitors the entire web to alert your reps when target accounts show active buying intent.
          </p>
        </div>
        <div>
          <AccountIntelligence />
        </div>
      </div>
    </Container>
  </section>

  <section class="py-32 bg-gray-50">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="order-1 lg:order-2">
          <h2 class="text-h2 mb-6">Map the committee instantly.</h2>
          <p class="text-body-large mb-8">
            Vero automatically identifies the decision makers at high-intent accounts, tracking their job changes, social posts, and website visits in one unified profile.
          </p>
        </div>
        <div class="order-2 lg:order-1">
          <ProspectIntelligence />
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
