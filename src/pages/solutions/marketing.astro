---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/layout/Container.astro';
import WorkflowBuilder from '../../components/mockups/WorkflowBuilder.astro';
import AIPersonalization from '../../components/mockups/AIPersonalization.astro';
import Button from '../../components/ui/primitives/Button.astro';
---

<BaseLayout headerStyle="v1" footerStyle="v1" showAnnouncement={true} title="Vero for Marketing" description="Scale your ABM campaigns with AI workflows.">
  <section class="pt-32 pb-20 bg-gray-50 text-center">
    <Container>
      <span class="text-eyebrow mb-4 block">VERO FOR MARKETING</span>
      <h1 class="text-display mb-6 max-w-4xl mx-auto">Scale ABM with precision.</h1>
      <p class="text-body-large mb-10 max-w-2xl mx-auto">
        Run highly personalized Account-Based Marketing campaigns automatically. Vero triggers sequences and personalization based on real-time intent data.
      </p>
      <Button href="/pricing" variant="primary" size="large">Start free trial</Button>
    </Container>
  </section>

  <section class="py-32 bg-white">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-h2 mb-6">Automate your ABM plays.</h2>
          <p class="text-body-large mb-8">
            Build complex workflows that automatically add high-intent accounts to specific ad audiences or trigger personalized outbound sequences the moment they research competitors.
          </p>
        </div>
        <div>
          <WorkflowBuilder />
        </div>
      </div>
    </Container>
  </section>

  <section class="py-32 bg-gray-50">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="order-1 lg:order-2">
          <h2 class="text-h2 mb-6">Personalize at scale.</h2>
          <p class="text-body-large mb-8">
            Use AI to draft context-aware outbound emails on behalf of your sales reps, incorporating news, funding rounds, and recent website visits automatically.
          </p>
        </div>
        <div class="order-2 lg:order-1">
          <AIPersonalization />
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
