---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/layout/Container.astro';
import AccountIntelligence from '../../components/sections/AccountIntelligence.astro';
import WorkflowBuilder from '../../components/sections/WorkflowBuilder.astro';
import Button from '../../components/ui/primitives/Button.astro';
---

<BaseLayout headerStyle="v1" footerStyle="v1" showAnnouncement={true} title="Platform" description="The complete GTM intelligence and automation platform.">
  <section class="pt-32 pb-20 bg-gray-50 text-center">
    <Container>
      <span class="text-eyebrow mb-4 block">THE PLATFORM</span>
      <h1 class="text-display mb-6 max-w-4xl mx-auto">One platform for your entire outbound motion.</h1>
      <p class="text-body-large mb-10 max-w-2xl mx-auto">
        Vero brings data enrichment, intent signals, AI research, and workflow automation into a single, cohesive platform designed for modern revenue teams.
      </p>
    </Container>
  </section>

  <!-- Account Intelligence -->
  <section class="py-32 bg-white">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-h2 mb-6">Uncover hidden pipeline.</h2>
          <p class="text-body-large mb-8">
            Stop waiting for inbound. Vero continuously monitors your total addressable market for the specific signals that indicate an account is ready to engage.
          </p>
          <ul class="list-none p-0 m-0">
            <li class="mb-4 text-base leading-relaxed text-text-secondary"><strong class="text-text-primary">Intent Scoring:</strong> Know exactly who is in-market right now.</li>
            <li class="mb-4 text-base leading-relaxed text-text-secondary"><strong class="text-text-primary">Technographics:</strong> Find companies using complementary or competitor tools.</li>
            <li class="mb-4 text-base leading-relaxed text-text-secondary"><strong class="text-text-primary">Growth Signals:</strong> Track hiring, funding, and key leadership changes.</li>
          </ul>
        </div>
        <div>
          <AccountIntelligence />
        </div>
      </div>
    </Container>
  </section>

  <!-- Workflow Automation -->
  <section class="py-32 bg-gray-50">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="order-2 lg:order-1">
          <WorkflowBuilder />
        </div>
        <div class="order-1 lg:order-2">
          <h2 class="text-h2 mb-6">Scale your best reps.</h2>
          <p class="text-body-large mb-8">
            What takes a human 30 minutes to research and draft now happens instantly. Build workflows that trigger automatically when a buying signal is detected.
          </p>
          <ul class="list-none p-0 m-0">
            <li class="mb-4 text-base leading-relaxed text-text-secondary"><strong class="text-text-primary">Signal Triggers:</strong> Launch plays the moment intent is detected.</li>
            <li class="mb-4 text-base leading-relaxed text-text-secondary"><strong class="text-text-primary">AI Research:</strong> Let AI summarize the account and find the best angle.</li>
            <li class="mb-4 text-base leading-relaxed text-text-secondary"><strong class="text-text-primary">Cross-Platform Execution:</strong> Sync to Salesforce and trigger Outreach sequences.</li>
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <section class="py-32 bg-white text-center">
    <Container>
      <h2 class="text-h2 mb-10">See the platform in action</h2>
      <Button href="/company/contact" variant="primary" size="large">Book a personalized demo</Button>
    </Container>
  </section>
</BaseLayout>
