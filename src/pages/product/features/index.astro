---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/ui/layout/Container.astro';
---

<BaseLayout headerStyle="v1" footerStyle="v1" showAnnouncement={true} title="Features" description="Explore all features of Vero.">
  <section class="py-32 bg-gray-50 text-center">
    <Container>
      <h1 class="text-display mb-6">Platform Features</h1>
      <p class="text-body-large max-w-2xl mx-auto">
        Deep dive into the capabilities that make Vero the most powerful intent data platform.
      </p>
    </Container>
  </section>
  <section class="py-32 bg-white text-center">
    <Container>
      <p class="text-text-muted">Feature directory coming soon.</p>
    </Container>
  </section>
</BaseLayout>
