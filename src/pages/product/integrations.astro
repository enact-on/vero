---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/layout/Container.astro';
import SectionHeading from '../../components/ui/marketing/SectionHeading.astro';
import IntegrationUI from '../../components/mockups/IntegrationUI.astro';
import Button from '../../components/ui/primitives/Button.astro';
---

<BaseLayout headerStyle="v1" footerStyle="v1" showAnnouncement={true} title="Integrations - Vero" description="Connect Vero with your entire GTM stack.">
  <section class="pt-32 pb-20 bg-gray-50 text-center">
    <Container>
      <span class="text-eyebrow mb-4 block">INTEGRATIONS</span>
      <h1 class="text-display mb-6 max-w-4xl mx-auto">Works with your existing stack.</h1>
      <p class="text-body-large mb-10 max-w-2xl mx-auto">
        Vero seamlessly connects with your CRM, marketing automation, and communication tools. Bi-directional syncing means your data is always up to date.
      </p>
    </Container>
  </section>

  <section class="py-32 bg-white">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-h2 mb-6">Connect once, sync everywhere.</h2>
          <p class="text-body-large mb-8">
            Our native integrations allow you to push enriched accounts to Salesforce, trigger HubSpot sequences based on intent, and get Slack alerts the moment a target account visits your pricing page.
          </p>
          <ul class="list-none p-0 m-0 mb-8">
            <li class="flex items-center gap-3 mb-3 font-medium"><svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg> Bi-directional CRM sync</li>
            <li class="flex items-center gap-3 mb-3 font-medium"><svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg> Real-time intent routing</li>
            <li class="flex items-center gap-3 mb-3 font-medium"><svg class="w-5 h-5 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg> 1-click installation</li>
          </ul>
        </div>
        <div class="p-8 rounded-xl bg-gray-50 border border-gray-200">
          <IntegrationUI />
        </div>
      </div>
    </Container>
  </section>

  <section class="py-32 bg-gray-900 text-center text-white">
    <Container>
      <h2 class="text-h2 mb-6 text-white">Don't see your tool?</h2>
      <p class="text-body-large mb-8 max-w-2xl mx-auto text-gray-400">
        We support custom webhooks and have a robust REST API for enterprise customers to build custom data flows.
      </p>
      <Button href="/company/contact" variant="primary" size="large">Talk to API sales</Button>
    </Container>
  </section>
</BaseLayout>
