---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/layout/Container.astro';
import Button from '../../components/ui/primitives/Button.astro';
---

<BaseLayout headerStyle="v1" footerStyle="v1" showAnnouncement={true} title="Contact Us" description="Get in touch with the Vero team.">
  <section class="py-32 bg-gray-50">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <div>
          <h1 class="text-display mb-6">Let's talk about your pipeline.</h1>
          <p class="text-body-large mb-10">
            Whether you have a question about features, pricing, or want a custom demo, our team is ready to answer all your questions.
          </p>
          
          <div class="flex flex-col gap-6 mt-12">
            <div>
              <h4 class="text-lg font-semibold mb-2">Sales</h4>
              <p class="text-text-secondary m-0 leading-relaxed">sales@vero-theme.example.com</p>
            </div>
            <div>
              <h4 class="text-lg font-semibold mb-2">Support</h4>
              <p class="text-text-secondary m-0 leading-relaxed">support@vero-theme.example.com</p>
            </div>
            <div>
              <h4 class="text-lg font-semibold mb-2">HQ</h4>
              <p class="text-text-secondary m-0 leading-relaxed">100 SaaS Way, Suite 400<br>San Francisco, CA 94107</p>
            </div>
          </div>
        </div>
        
        <div>
          <form class="bg-white p-8 rounded-xl border border-border shadow-md" action="#" method="POST">
            <div class="mb-6">
              <label for="email" class="block text-sm font-medium mb-2 text-text-primary">Work Email</label>
              <input type="email" id="email" name="email" class="w-full px-4 py-3 border border-border rounded-md bg-gray-50 font-inherit text-base text-text-primary transition-all duration-200 outline-none focus:border-primary focus:ring-3 focus:ring-primary/20 focus:bg-white" placeholder="jane@company.com" required>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
              <div>
                <label for="firstName" class="block text-sm font-medium mb-2 text-text-primary">First Name</label>
                <input type="text" id="firstName" name="firstName" class="w-full px-4 py-3 border border-border rounded-md bg-gray-50 font-inherit text-base text-text-primary transition-all duration-200 outline-none focus:border-primary focus:ring-3 focus:ring-primary/20 focus:bg-white" required>
              </div>
              <div>
                <label for="lastName" class="block text-sm font-medium mb-2 text-text-primary">Last Name</label>
                <input type="text" id="lastName" name="lastName" class="w-full px-4 py-3 border border-border rounded-md bg-gray-50 font-inherit text-base text-text-primary transition-all duration-200 outline-none focus:border-primary focus:ring-3 focus:ring-primary/20 focus:bg-white" required>
              </div>
            </div>
            <div class="mb-6">
              <label for="company" class="block text-sm font-medium mb-2 text-text-primary">Company</label>
              <input type="text" id="company" name="company" class="w-full px-4 py-3 border border-border rounded-md bg-gray-50 font-inherit text-base text-text-primary transition-all duration-200 outline-none focus:border-primary focus:ring-3 focus:ring-primary/20 focus:bg-white" required>
            </div>
            <div class="mb-6">
              <label for="message" class="block text-sm font-medium mb-2 text-text-primary">How can we help?</label>
              <textarea id="message" name="message" rows="4" class="w-full px-4 py-3 border border-border rounded-md bg-gray-50 font-inherit text-base text-text-primary transition-all duration-200 outline-none focus:border-primary focus:ring-3 focus:ring-primary/20 focus:bg-white" placeholder="Tell us about your current GTM motion..."></textarea>
            </div>
            <Button type="submit" variant="primary" class="w-full flex justify-center">Get in touch</Button>
            <p class="mt-4 text-xs text-text-muted text-center">By submitting this form, you agree to our <a href="/legal/privacy" class="text-primary underline">Privacy Policy</a>.</p>
          </form>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
