---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/layout/Container.astro';
import SectionHeading from '../../components/ui/marketing/SectionHeading.astro';
import Button from '../../components/ui/primitives/Button.astro';
---

<BaseLayout headerStyle="v1" footerStyle="v1" showAnnouncement={true} title="Careers - Vero" description="Join us in redefining B2B outbound.">
  <section class="pt-32 pb-20 bg-gray-50 text-center">
    <Container>
      <span class="text-eyebrow mb-4 block">CAREERS AT VERO</span>
      <h1 class="text-display mb-6 max-w-4xl mx-auto">Help us fix GTM.</h1>
      <p class="text-body-large mb-10 max-w-2xl mx-auto">
        We're a fast-growing, remote-first team building the intelligent orchestration layer for modern revenue teams. Come build the future with us.
      </p>
    </Container>
  </section>

  <section class="py-32 bg-white">
    <Container>
      <SectionHeading 
        title="Open Roles" 
        description="We're always looking for exceptional talent. Don't see a fit? Reach out anyway." 
      />
      
      <div class="flex flex-col gap-12 mt-16 max-w-4xl mx-auto">
        
        <!-- Job Category -->
        <div>
          <h3 class="text-2xl font-bold mb-6 pb-4 border-b-2 border-gray-100 text-text-primary">Engineering</h3>
          
          <div class="flex items-center justify-between py-6 border-b border-border transition-colors duration-200 hover:bg-gray-50 hover:-mx-4 hover:px-4 hover:rounded-lg hover:border-transparent cursor-pointer group">
            <div>
              <h4 class="text-lg font-semibold mb-1 text-text-primary">Senior Full-Stack Engineer</h4>
              <span class="text-sm text-text-secondary">Remote (US/Canada) • Full-time</span>
            </div>
            <Button href="/" variant="outline" size="small">View Role</Button>
          </div>
          
          <div class="flex items-center justify-between py-6 border-b border-border transition-colors duration-200 hover:bg-gray-50 hover:-mx-4 hover:px-4 hover:rounded-lg hover:border-transparent cursor-pointer group">
            <div>
              <h4 class="text-lg font-semibold mb-1 text-text-primary">Machine Learning Engineer</h4>
              <span class="text-sm text-text-secondary">Remote (Global) • Full-time</span>
            </div>
            <Button href="/" variant="outline" size="small">View Role</Button>
          </div>
        </div>

        <!-- Job Category -->
        <div>
          <h3 class="text-2xl font-bold mb-6 pb-4 border-b-2 border-gray-100 text-text-primary">Go-to-Market</h3>
          
          <div class="flex items-center justify-between py-6 border-b border-border transition-colors duration-200 hover:bg-gray-50 hover:-mx-4 hover:px-4 hover:rounded-lg hover:border-transparent cursor-pointer group">
            <div>
              <h4 class="text-lg font-semibold mb-1 text-text-primary">Account Executive (Mid-Market)</h4>
              <span class="text-sm text-text-secondary">Remote (US) • Full-time</span>
            </div>
            <Button href="/" variant="outline" size="small">View Role</Button>
          </div>
          
          <div class="flex items-center justify-between py-6 border-b border-border transition-colors duration-200 hover:bg-gray-50 hover:-mx-4 hover:px-4 hover:rounded-lg hover:border-transparent cursor-pointer group">
            <div>
              <h4 class="text-lg font-semibold mb-1 text-text-primary">Product Marketing Manager</h4>
              <span class="text-sm text-text-secondary">Remote (US/EMEA) • Full-time</span>
            </div>
            <Button href="/" variant="outline" size="small">View Role</Button>
          </div>
        </div>

      </div>
    </Container>
  </section>
</BaseLayout>
