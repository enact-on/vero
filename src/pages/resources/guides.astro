---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/layout/Container.astro';
import Button from '../../components/ui/primitives/Button.astro';
---

<BaseLayout headerStyle="v1" footerStyle="v1" showAnnouncement={true} title="Vero Guides" description="Deep-dive playbooks and guides for B2B GTM.">
  <section class="pt-32 pb-20 bg-gray-50 text-center">
    <Container>
      <span class="text-eyebrow mb-4 block">PLAYBOOKS & GUIDES</span>
      <h1 class="text-display mb-6 max-w-4xl mx-auto">Master the art of outbound.</h1>
      <p class="text-body-large mb-10 max-w-2xl mx-auto">
        Comprehensive guides on building pipeline, using intent data, and scaling revenue teams.
      </p>
    </Container>
  </section>

  <section class="py-20 bg-white">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">
        <article class="bg-white border border-border rounded-xl overflow-hidden shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-lg">
          <div class="h-[240px] border-b border-border bg-gradient-to-br from-primary/80 to-orange-400/80"></div>
          <div class="p-8">
            <h3 class="text-2xl font-bold mb-4 text-text-primary leading-snug">The 2025 State of Account-Based Marketing</h3>
            <p class="text-text-secondary text-base mb-8 leading-relaxed">Learn how the top 1% of revenue teams are shifting their ABM strategies to rely entirely on intent signals.</p>
            <Button href="/" variant="outline" class="w-full flex justify-center">Download PDF</Button>
          </div>
        </article>
        
        <article class="bg-white border border-border rounded-xl overflow-hidden shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-lg">
          <div class="h-[240px] border-b border-border bg-gradient-to-br from-[#10B981]/80 to-[#059669]/80"></div>
          <div class="p-8">
            <h3 class="text-2xl font-bold mb-4 text-text-primary leading-snug">Playbook: Migrating from Cold Calls to Warm Intro Sequences</h3>
            <p class="text-text-secondary text-base mb-8 leading-relaxed">A step-by-step framework for training your SDRs to research trigger events instead of making dialer calls.</p>
            <Button href="/" variant="outline" class="w-full flex justify-center">Download PDF</Button>
          </div>
        </article>
      </div>
    </Container>
  </section>
</BaseLayout>
