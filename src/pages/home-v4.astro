---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/images/astr-theme-hero.png";
---

<BaseLayout headerStyle="v1" footerStyle="v3" title="Vero for Enterprise">
  <main class="w-full pt-16 bg-surface">
    <div class="flex flex-col w-full">
      <!-- Subtle Ambient Glow Canvas Decor -->
      <div class="relative w-full overflow-hidden bg-surface">
        <div
          class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[850px] h-[480px] bg-primary-fixed/35 blur-[120px] rounded-full"
        >
        </div>
        <div
          class="pointer-events-none absolute top-48 right-10 w-[380px] h-[380px] bg-secondary-fixed/40 blur-[90px] rounded-full"
        >
        </div>
        <!-- 1. HERO SECTION -->
        <section
          data-animate="fade-up"
          class="relative max-w-7xl mx-auto px-margin pt-32 pb-20 flex flex-col items-center text-center"
        >
          <!-- Trust Pill -->
          <div
            class="inline-flex items-center gap-2 px-8 py-1 bg-surface-container-lowest shadow-md rounded-full mb-12"
          >
            <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span>
            <span
              class="text-sm font-semibold tracking-wider text-on-surface uppercase tracking-wider"
              >Series A &amp; Enterprise GTM • Backed by Y Combinator alumni</span
            >
          </div>
          <!-- Main Headline -->
          <h1
            class="text-5xl md:text-6xl lg:text-7xl font-extrabold text-on-surface tracking-tighter leading-tight max-w-5xl mx-auto mb-8"
          >
            Your AI sales agent finds <span
              class="text-primary underline decoration-primary-fixed decoration-wavy decoration-2"
              >high-intent leads</span
            > and contacts them for you.
          </h1>
          <!-- Subhead -->
          <p
            class="text-lg md:text-xl text-on-surface-variant max-w-3xl mx-auto mb-12 leading-relaxed opacity-90"
          >
            Enter your website. Vero learns your business ICP, identifies your
            best prospects across 85+ live intent channels, and runs verified
            multichannel outreach automatically.
          </p>
          <!-- Instant Website Input Widget -->
          <div class="w-full max-w-xl mx-auto mb-12">
            <div
              class="p-1.5 bg-surface-container-lowest shadow-md rounded-full flex flex-col sm:flex-row items-center gap-2"
            >
              <div
                class="flex items-center pl-8 flex-1 w-full gap-2 text-on-surface-variant"
              >
                <span class="material-symbols-outlined text-[20px] text-primary"
                  >language</span
                >
                <input
                  class="w-full bg-transparent text-lg text-on-surface placeholder:text-outline/70 focus:outline-none py-3 px-3"
                  id="hero-url-input"
                  placeholder="Enter your website (e.g. stripe.com)"
                  type="text"
                  value="https://monolith-data.io"
                />
              </div>
              <button
                class="w-full sm:w-auto px-8 py-4 bg-primary text-on-primary font-semibold text-lg rounded-full shadow-lg hover:shadow-xl hover:bg-secondary transition-all flex items-center justify-center gap-2 shrink-0 cursor-pointer hover:-translate-y-0.5"
                id="hero-launch-btn"
                onclick="simulateAgentAnalysis()"
                type="button"
              >
                <span>Launch my agent for free</span>
                <span class="material-symbols-outlined text-[16px]"
                  >arrow_forward</span
                >
              </button>
            </div>
          </div>
          <!-- Social Proof Rating & Quote Bar -->
          <div
            class="flex flex-wrap items-center justify-center gap-8 text-left mb-24"
          >
            <div class="flex -space-x-2 overflow-hidden">
              <div
                class="w-7 h-7 rounded-full bg-primary-container text-on-primary text-sm font-semibold tracking-wider flex items-center justify-center shadow-md"
              >
                SL
              </div>
              <div
                class="w-7 h-7 rounded-full bg-secondary-container text-on-secondary-container text-sm font-semibold tracking-wider flex items-center justify-center shadow-md"
              >
                MR
              </div>
              <div
                class="w-7 h-7 rounded-full bg-tertiary-container text-on-tertiary text-sm font-semibold tracking-wider flex items-center justify-center shadow-md"
              >
                AK
              </div>
              <div
                class="w-7 h-7 rounded-full bg-primary text-on-primary text-sm font-semibold tracking-wider flex items-center justify-center shadow-md"
              >
                +2k
              </div>
            </div>
            <div class="flex items-center gap-1 text-on-surface">
              <span
                class="material-symbols-outlined text-[16px] text-amber-500"
                style="font-variation-settings: 'FILL' 1;">star</span
              >
              <span
                class="material-symbols-outlined text-[16px] text-amber-500"
                style="font-variation-settings: 'FILL' 1;">star</span
              >
              <span
                class="material-symbols-outlined text-[16px] text-amber-500"
                style="font-variation-settings: 'FILL' 1;">star</span
              >
              <span
                class="material-symbols-outlined text-[16px] text-amber-500"
                style="font-variation-settings: 'FILL' 1;">star</span
              >
              <span
                class="material-symbols-outlined text-[16px] text-amber-500"
                style="font-variation-settings: 'FILL' 1;">star</span
              >
              <span class="font-mono tracking-tight font-semibold ml-1"
                >4.9 / 5</span
              >
            </div>
            <span class="text-outline-variant font-label-sm">•</span>
            <p
              class="text-sm md:text-base text-on-surface-variant italic max-w-sm"
            >
              “Vero booked 18 enterprise demos in week one without human
              fatigue.”
            </p>
          </div>
          <!-- Hero Visual Image -->
          <div
            class="w-full max-w-5xl mx-auto rounded-2xl bg-white border border-gray-100 shadow-[0_20px_50px_rgba(0,0,0,0.07)] overflow-hidden text-left transition-all relative"
          >
            <Image
              src={heroImage}
              alt="Vero Dashboard"
              class="w-full h-auto block"
            />
          </div>
        </section>
        <!-- 2. SOCIAL PROOF / LOGO MARQUEE -->
        <section
          data-animate="fade-up"
          class="w-full bg-surface-container-low py-20 shadow-md"
        >
          <div class="max-w-7xl mx-auto px-margin text-center">
            <p
              class="text-sm font-semibold tracking-wider text-on-surface-variant uppercase tracking-wider mb-8"
            >
              Trusted by 2,500+ high-growth revenue leaders and GTM architects
              worldwide
            </p>
            <div
              class="grid grid-cols-2 md:grid-cols-6 gap-8 md:p-12 items-center justify-center opacity-70"
            >
              <span
                class="text-2xl md:text-3xl font-bold tracking-tight tracking-tighter text-on-surface font-bold"
                >Ramp</span
              >
              <span
                class="text-2xl md:text-3xl font-bold tracking-tight tracking-tight text-on-surface font-semibold"
                >Datastream</span
              >
              <span
                class="text-2xl md:text-3xl font-bold tracking-tight tracking-tight text-on-surface font-bold"
                >Vercel</span
              >
              <span
                class="text-2xl md:text-3xl font-bold tracking-tight tracking-widest text-on-surface font-medium uppercase"
                >Klaviyo</span
              >
              <span
                class="text-2xl md:text-3xl font-bold tracking-tight tracking-tighter text-on-surface font-bold"
                >Gusto</span
              >
              <span
                class="text-2xl md:text-3xl font-bold tracking-tight tracking-tight text-on-surface font-semibold"
                >Snowflake</span
              >
            </div>
          </div>
        </section>
        <!-- 3. PROGRESSIVE 4-STEP AGENT SHOWCASE -->
        <section data-animate="fade-up" class="w-full py-32 bg-surface">
          <div class="max-w-7xl mx-auto px-margin">
            <!-- Section Header with Gojiberry styling -->
            <div class="mb-24 max-w-3xl">
              <div
                class="inline-flex items-center gap-2 text-primary font-mono tracking-tight uppercase tracking-wider mb-2"
              >
                <span class="w-2 h-2 rounded-full bg-primary"></span> Continuous Autopilot
              </div>
              <h2
                class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight mb-4 text-on-surface"
              >
                Your sales agent runs 24/7. And gets better every week.
              </h2>
              <p class="text-xl leading-relaxed text-on-surface-variant mt-2">
                From finding the right buyer to sending hyper-relevant messages,
                your agent handles it end-to-end.
              </p>
            </div>
            <!-- Progression Cards Grid -->
            <div class="space-y-16">
              <!-- Feature 1: Finds & scores your best leads first -->
              <div
                class="bg-surface-container-lowest rounded-xl shadow-md p-8 md:p-12 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center"
              >
                <div class="lg:col-span-5 order-2 lg:order-1">
                  <span
                    class="inline-block px-2 py-0.5 bg-primary-fixed text-on-primary-fixed font-mono tracking-tight rounded mb-2"
                    >01 / 04</span
                  >
                  <h3
                    class="font-headline-lg text-headline-lg text-on-surface mb-4"
                  >
                    Finds &amp; scores your best leads first
                  </h3>
                  <p
                    class="text-base md:text-lg text-on-surface-variant leading-relaxed leading-relaxed mb-8"
                  >
                    Your agent detects heavy job intent signals, scores every
                    prospect against your target criteria, and prioritizes the
                    accounts most likely to convert before competitors even
                    notice.
                  </p>
                  <div class="flex flex-wrap gap-2">
                    <span
                      class="px-4 py-1 bg-surface-container-low text-on-surface font-code-tabular text-[12px] rounded-full flex items-center gap-1"
                    >
                      <span class="w-1.5 h-1.5 rounded-full bg-secondary"
                      ></span> Competitor churn intent +48%
                    </span>
                    <span
                      class="px-4 py-1 bg-surface-container-low text-on-surface font-code-tabular text-[12px] rounded-full flex items-center gap-1"
                    >
                      <span class="w-1.5 h-1.5 rounded-full bg-primary"></span> Executive
                      hire: VP Growth
                    </span>
                    <span
                      class="px-4 py-1 bg-surface-container-low text-on-surface font-code-tabular text-[12px] rounded-full flex items-center gap-1"
                    >
                      <span
                        class="w-1.5 h-1.5 rounded-full bg-primary-container text-on-primary"
                        >Series B raised ($35M)</span
                      >
                    </span>
                  </div>
                </div>
                <div
                  class="lg:col-span-7 order-1 lg:order-2 bg-surface-container-low rounded-xl p-8"
                >
                  <div
                    class="bg-surface-container-lowest rounded-lg p-8 shadow-md"
                  >
                    <div
                      class="flex items-center justify-between pb-4 mb-4 bg-surface-container-low/40 -mx-8 -mt-8 px-8 pt-4 rounded-t-lg"
                    >
                      <div
                        class="text-base font-semibold text-on-surface font-semibold"
                      >
                        Priority Account Radar
                      </div>
                      <div
                        class="font-mono tracking-tight text-primary font-bold"
                      >
                        12 High-Surge Accounts Today
                      </div>
                    </div>
                    <div class="space-y-2">
                      <!-- Account 1 -->
                      <div
                        class="flex items-center justify-between p-4 rounded bg-surface-container-low hover:bg-surface-container-high transition-colors"
                      >
                        <div class="flex items-center gap-4">
                          <div
                            class="w-8 h-8 rounded-full bg-primary text-on-primary flex items-center justify-center font-headline-sm text-[12px]"
                          >
                            NX
                          </div>
                          <div>
                            <div
                              class="text-xl md:text-2xl font-bold tracking-tight text-on-surface"
                            >
                              Nexus Logistics Inc.
                            </div>
                            <div
                              class="font-body-sm text-[11px] text-on-surface-variant"
                            >
                              540 Employees • Enterprise Supply Chain
                            </div>
                          </div>
                        </div>
                        <div class="text-right">
                          <span
                            class="px-2 py-0.5 bg-primary text-on-primary font-mono tracking-tight rounded-full"
                            >Score 98/100</span
                          >
                          <div
                            class="text-[10px] text-on-surface-variant mt-0.5"
                          >
                            3 VP triggers detected
                          </div>
                        </div>
                      </div>
                      <!-- Account 2 -->
                      <div
                        class="flex items-center justify-between p-4 rounded bg-surface-container-low hover:bg-surface-container-high transition-colors"
                      >
                        <div class="flex items-center gap-4">
                          <div
                            class="w-8 h-8 rounded-full bg-secondary text-on-secondary flex items-center justify-center font-headline-sm text-[12px]"
                          >
                            KV
                          </div>
                          <div>
                            <div
                              class="text-xl md:text-2xl font-bold tracking-tight text-on-surface"
                            >
                              Kinetix Vector
                            </div>
                            <div
                              class="font-body-sm text-[11px] text-on-surface-variant"
                            >
                              1,200 Employees • AI Infrastructure
                            </div>
                          </div>
                        </div>
                        <div class="text-right">
                          <span
                            class="px-2 py-0.5 bg-primary-fixed text-on-primary-fixed font-mono tracking-tight rounded-full"
                            >Score 94/100</span
                          >
                          <div
                            class="text-[10px] text-on-surface-variant mt-0.5"
                          >
                            Budget expanded Q2
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Feature 2: Only your best prospects. Nothing else -->
              <div
                class="bg-surface-container-lowest rounded-xl shadow-md p-8 md:p-12 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center"
              >
                <div
                  class="lg:col-span-7 bg-surface-container-low rounded-xl p-8"
                >
                  <div
                    class="bg-surface-container-lowest rounded-lg p-8 shadow-md"
                  >
                    <div class="flex items-center justify-between mb-8">
                      <span
                        class="text-base font-semibold text-on-surface font-semibold"
                        >Strict ICP Precision Waterfall</span
                      >
                      <span class="font-mono tracking-tight text-secondary"
                        >Filtered 1,420 → 84 verified</span
                      >
                    </div>
                    <div class="space-y-2">
                      <div
                        class="p-2.5 rounded bg-surface-container-low flex items-center justify-between text-[12px]"
                      >
                        <span class="text-on-surface flex items-center gap-2">
                          <span
                            class="material-symbols-outlined text-[16px] text-primary"
                            >check_circle</span
                          >
                          Revenue: $15M to $150M ARR
                        </span>
                        <span class="font-code-tabular text-on-surface-variant"
                          >PASS (100%)</span
                        >
                      </div>
                      <div
                        class="p-2.5 rounded bg-surface-container-low flex items-center justify-between text-[12px]"
                      >
                        <span class="text-on-surface flex items-center gap-2">
                          <span
                            class="material-symbols-outlined text-[16px] text-primary"
                            >check_circle</span
                          >
                          Buyer Authority: VP or C-Level in Sales/GTM
                        </span>
                        <span class="font-code-tabular text-on-surface-variant"
                          >PASS (100%)</span
                        >
                      </div>
                      <div
                        class="p-2.5 rounded bg-surface-container-low flex items-center justify-between text-[12px]"
                      >
                        <span class="text-on-surface flex items-center gap-2">
                          <span
                            class="material-symbols-outlined text-[16px] text-error"
                            >cancel</span
                          >
                          Zero spam-trap or unverified SMTP
                        </span>
                        <span class="font-code-tabular text-error"
                          >128 DISCARDED</span
                        >
                      </div>
                    </div>
                  </div>
                </div>
                <div class="lg:col-span-5">
                  <span
                    class="inline-block px-2 py-0.5 bg-primary-fixed text-on-primary-fixed font-mono tracking-tight rounded mb-2"
                    >02 / 04</span
                  >
                  <h3
                    class="font-headline-lg text-headline-lg text-on-surface mb-4"
                  >
                    Only your best prospects. Nothing else.
                  </h3>
                  <p
                    class="text-base md:text-lg text-on-surface-variant leading-relaxed leading-relaxed"
                  >
                    Every lead is pre-filtered to match your exact ICP
                    parameters. Your agent will never reach out to bad fits,
                    unqualified titles, or outdated records that burn your
                    domain reputation.
                  </p>
                </div>
              </div>
              <!-- Feature 3: Multichannel outreach that books demos -->
              <div
                class="bg-surface-container-lowest rounded-xl shadow-md p-8 md:p-12 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center"
              >
                <div class="lg:col-span-5 order-2 lg:order-1">
                  <span
                    class="inline-block px-2 py-0.5 bg-primary-fixed text-on-primary-fixed font-mono tracking-tight rounded mb-2"
                    >03 / 04</span
                  >
                  <h3
                    class="font-headline-lg text-headline-lg text-on-surface mb-4"
                  >
                    Multichannel outreach that books demos
                  </h3>
                  <p
                    class="text-base md:text-lg text-on-surface-variant leading-relaxed leading-relaxed mb-8"
                  >
                    Your agent reaches out via tailored cold email and LinkedIn
                    message sequences, scheduled natively with human-grade
                    intervals. No robotic templates.
                  </p>
                  <div class="flex items-center gap-8">
                    <div
                      class="flex items-center gap-1.5 text-on-surface text-body-sm font-medium"
                    >
                      <span
                        class="material-symbols-outlined text-primary text-[18px]"
                        >verified</span
                      >
                      100% human-in-the-loop review optional
                    </div>
                  </div>
                </div>
                <div
                  class="lg:col-span-7 order-1 lg:order-2 bg-surface-container-low rounded-xl p-8"
                >
                  <div
                    class="bg-surface-container-lowest rounded-lg p-8 shadow-md"
                  >
                    <div class="flex items-center justify-between pb-4 mb-4">
                      <div class="flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full bg-primary"
                        ></span>
                        <span
                          class="text-base font-semibold text-on-surface font-semibold"
                          >Autonomous Outreach Composer</span
                        >
                      </div>
                      <span class="text-[11px] font-code-tabular text-primary"
                        >Optimized for Deliverability</span
                      >
                    </div>
                    <div
                      class="p-4 rounded bg-surface-container-low text-body-sm leading-relaxed mb-4"
                    >
                      <p class="font-semibold text-on-surface mb-1">
                        Subject: Quick note regarding your team's expansion in
                        EMEA
                      </p>
                      <p class="text-on-surface-variant text-[13px]">
                        “Marcus, noticed you just opened hiring for 4 Account
                        Execs in London. When scaling cross-region reps,
                        pipeline visibility usually takes a hit in month two. We
                        built Vero to give leaders automated coverage across
                        unassigned tier-1 accounts...”
                      </p>
                    </div>
                    <div
                      class="flex items-center justify-between text-body-sm pt-2"
                    >
                      <span class="text-on-surface-variant text-[11px]"
                        >Personalization hook: 10-K SEC Filing + LinkedIn Job
                        Post</span
                      >
                      <span
                        class="font-code-tabular text-primary font-semibold text-[12px]"
                        >Projected Reply: 38.4%</span
                      >
                    </div>
                  </div>
                </div>
              </div>
              <!-- Feature 4: Gets better every week -->
              <div
                class="bg-surface-container-lowest rounded-xl shadow-md p-8 md:p-12 grid grid-cols-1 lg:grid-cols-12 gap-16 items-center"
              >
                <div
                  class="lg:col-span-7 bg-surface-container-low rounded-xl p-8"
                >
                  <div
                    class="bg-surface-container-lowest rounded-lg p-8 shadow-md"
                  >
                    <div class="flex items-center justify-between mb-8">
                      <span
                        class="text-base font-semibold text-on-surface font-semibold"
                        >Weekly Self-Tuning Performance Lift</span
                      >
                      <span
                        class="font-mono tracking-tight text-primary font-bold"
                        >+64% Qualified Pipeline</span
                      >
                    </div>
                    <!-- Inline Data Visualization Chart -->
                    <div
                      class="h-44 w-full flex items-end justify-between gap-8 pt-8 px-4"
                    >
                      <!-- Week 1 -->
                      <div
                        class="flex-1 flex flex-col items-center gap-2 h-full justify-end"
                      >
                        <span
                          class="font-mono tracking-tight text-on-surface-variant"
                          >14%</span
                        >
                        <div
                          class="w-full bg-primary-fixed rounded-t"
                          style="height: 28%;"
                        >
                        </div>
                        <span
                          class="text-sm font-semibold tracking-wider text-on-surface-variant"
                          >Wk 1</span
                        >
                      </div>
                      <!-- Week 2 -->
                      <div
                        class="flex-1 flex flex-col items-center gap-2 h-full justify-end"
                      >
                        <span
                          class="font-mono tracking-tight text-on-surface-variant"
                          >27%</span
                        >
                        <div
                          class="w-full bg-primary-fixed rounded-t"
                          style="height: 48%;"
                        >
                        </div>
                        <span
                          class="text-sm font-semibold tracking-wider text-on-surface-variant"
                          >Wk 2</span
                        >
                      </div>
                      <!-- Week 3 -->
                      <div
                        class="flex-1 flex flex-col items-center gap-2 h-full justify-end"
                      >
                        <span
                          class="font-mono tracking-tight text-on-surface-variant"
                          >42%</span
                        >
                        <div
                          class="w-full bg-secondary-fixed rounded-t"
                          style="height: 68%;"
                        >
                        </div>
                        <span
                          class="text-sm font-semibold tracking-wider text-on-surface-variant"
                          >Wk 3</span
                        >
                      </div>
                      <!-- Week 4 -->
                      <div
                        class="flex-1 flex flex-col items-center gap-2 h-full justify-end"
                      >
                        <span
                          class="font-mono tracking-tight text-primary font-bold"
                          >64%</span
                        >
                        <div
                          class="w-full bg-primary rounded-t"
                          style="height: 94%;"
                        >
                        </div>
                        <span
                          class="text-sm font-semibold tracking-wider font-bold text-on-surface"
                          >Wk 4</span
                        >
                      </div>
                    </div>
                  </div>
                </div>
                <div class="lg:col-span-5">
                  <span
                    class="inline-block px-2 py-0.5 bg-primary-fixed text-on-primary-fixed font-mono tracking-tight rounded mb-2"
                    >04 / 04</span
                  >
                  <h3
                    class="font-headline-lg text-headline-lg text-on-surface mb-4"
                  >
                    Gets better every week
                  </h3>
                  <p
                    class="text-base md:text-lg text-on-surface-variant leading-relaxed leading-relaxed mb-8"
                  >
                    Your agent studies which subject lines, buyer titles, and
                    value props book the highest-value demos. It continually
                    adjusts copy tone and persona prioritization against real
                    outcomes.
                  </p>
                  <button
                    class="px-8 py-2.5 bg-primary text-on-primary text-base font-semibold rounded-full shadow hover:bg-secondary transition-all cursor-pointer"
                    onclick="document.getElementById('hero-url-input').focus()"
                    type="button"
                  >
                    Launch agent for free
                  </button>
                </div>
              </div>
            </div>
          </div>
        </section>
        <!-- 4. "3 MINUTES TO SET UP. FIRST MEETINGS TODAY" -->
        <section
          data-animate="fade-up"
          class="w-full py-32 bg-surface-container-low"
        >
          <div class="max-w-7xl mx-auto px-margin">
            <div class="text-center max-w-2xl mx-auto mb-24">
              <div
                class="inline-flex items-center gap-1.5 text-primary font-mono tracking-tight uppercase tracking-wider mb-2"
              >
                <span class="material-symbols-outlined text-[16px]">bolt</span> Frictionless
                Deployment
              </div>
              <h2
