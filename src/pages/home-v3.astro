---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/images/astr-theme-hero.png";

import imgFeature1 from "../assets/images/figma/feature-1.png";
import imgDiscover from "../assets/images/figma/image-4.png";
import imgUnderstand from "../assets/images/figma/feature-2.png";
import imgAct from "../assets/images/figma/feature-3.png";
import imgIntegrations from "../assets/images/figma/integrations.png";
import imgBannerPipeline from "../assets/images/figma/banner-pipeline.png";
---

<BaseLayout
  headerStyle="v1"
  footerStyle="v1"
  title="Vero — Build, Automate, & Control Revenue Agents"
>
  <div class="overflow-x-hidden">
    <!-- 1. HERO SECTION -->
    <section
      class="relative pt-24 pb-32 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto flex flex-col items-center text-center overflow-hidden"
    >
      <!-- Background Grid & Glow -->
      <div
        class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"
      >
      </div>
      <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-gradient-to-b from-primary/25 via-orange-400/15 to-transparent blur-3xl pointer-events-none -z-10 rounded-full opacity-70"
      >
      </div>

      <!-- Pill Badge -->
      <div
        class="group inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/40 backdrop-blur-sm border border-gray-200/60 shadow-sm mb-8 text-xs font-medium cursor-pointer hover:bg-white/60 transition-colors"
      >
        <div class="flex items-center gap-1.5">
          <span class="relative flex h-2 w-2">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary/80 opacity-75"
            ></span>
            <span
              class="relative inline-flex rounded-full h-2 w-2 bg-primary"
            ></span>
          </span>
          <span class="text-gray-900">Vero Revenue Agents v2.4</span>
        </div>
        <span class="text-gray-300">|</span>
        <span class="text-gray-600">Built for Series A/B GTM</span>
        <span
          class="text-gray-400 material-symbols-outlined text-[14px] group-hover:translate-x-0.5 transition-transform"
          >arrow_forward</span
        >
      </div>

      <!-- Main Headline -->
      <h1
        data-animate="fade-up"
        class="text-h1 text-gray-950 font-[650] tracking-[-0.05em] leading-[1.05] max-w-5xl mb-8"
      >
        Build, share, &amp; control <br class="hidden sm:inline" />
        <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-orange-500 to-amber-500"
        >
          autonomous revenue agents.
        </span>
      </h1>

      <p
        class="font-body text-lg sm:text-xl text-gray-600 max-w-3xl mb-10 leading-relaxed font-normal"
      >
        Turn every raw market signal, buying committee surge, and transcript
        into qualified outbound pipeline. Give your GTM team the power to
        automate multi-step prospecting without writing code.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center gap-4 mb-16 relative z-10">
        <a
          class="inline-flex items-center justify-center px-7 py-3.5 rounded-xl bg-gray-900 text-white font-medium text-sm hover:bg-black transition-all shadow-[0_1px_2px_rgba(0,0,0,0.2),_inset_0_1px_0_rgba(255,255,255,0.1)] hover:shadow-[0_4px_12px_rgba(0,0,0,0.15),_inset_0_1px_0_rgba(255,255,255,0.1)] group"
          href="#"
        >
          Get Started for free
          <span
            class="material-symbols-outlined text-[18px] ml-1.5 group-hover:translate-x-0.5 transition-transform"
            >arrow_forward</span
          >
        </a>
        <a
          class="inline-flex items-center justify-center px-7 py-3.5 rounded-xl bg-white border border-gray-200 text-gray-800 font-medium text-sm hover:bg-gray-50 hover:border-gray-300 transition-all shadow-sm group"
          href="#"
        >
          <span
            class="material-symbols-outlined text-[20px] mr-2 text-gray-400 group-hover:text-primary transition-colors"
            >play_circle</span
          >
          Book a demo
        </a>
      </div>

      <!-- HERO WORKSPACE CANVAS -->
      <div
        class="relative w-full max-w-[1200px] mx-auto mt-4 z-0 group perspective-[2000px]"
      >
        <!-- Glow behind image -->
        <div
          class="absolute -inset-2 bg-gradient-to-r from-primary/20 via-orange-400/20 to-amber-400/20 rounded-[2.5rem] blur-2xl opacity-50 group-hover:opacity-70 transition-opacity duration-700"
        >
        </div>

        <div
          class="relative rounded-2xl sm:rounded-[2rem] bg-white/40 backdrop-blur-xl p-2 sm:p-4 border border-white/60 shadow-[0_8px_40px_rgba(0,0,0,0.08)] ring-1 ring-gray-900/5 transform transition-transform duration-700 hover:scale-[1.01]"
        >
          <div
            class="rounded-xl sm:rounded-[1.5rem] overflow-hidden border border-gray-200/80 bg-gray-50 shadow-inner"
          >
            <!-- Optional Mac-like window controls -->
            <div
              class="h-10 border-b border-gray-200/80 bg-white/50 backdrop-blur-sm flex items-center px-4 gap-2"
            >
              <div class="w-3 h-3 rounded-full bg-gray-300 shadow-sm"></div>
              <div class="w-3 h-3 rounded-full bg-gray-300 shadow-sm"></div>
              <div class="w-3 h-3 rounded-full bg-gray-300 shadow-sm"></div>
              <div
                class="mx-auto text-[11px] font-medium text-gray-500 flex items-center gap-1.5 bg-white/60 px-3 py-1 rounded-md border border-gray-200/50 shadow-sm"
              >
                <span class="material-symbols-outlined text-[12px]">lock</span>
                vero.enacton.com
              </div>
            </div>
            <Image
              src={heroImage}
              alt="Vero Dashboard"
              class="w-full h-auto block"
            />
          </div>
        </div>
      </div>
    </section>
    <!-- 2. LOGO STRIP & STATS BAR (Gumloop inspired high impact counter) -->
    <section class="border-y border-gray-200 bg-white py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <!-- Enterprise Logos -->
          <div class="lg:col-span-7">
            <p
              class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-6 text-center lg:text-left"
            >
              The agent infrastructure powering high-growth revenue teams
            </p>
            <div
              class="relative overflow-hidden w-full group [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)] flex"
            >
              <div
                class="flex animate-marquee opacity-70 grayscale group-hover:grayscale-0 transition-all items-center whitespace-nowrap"
              >
                <div
                  class="flex items-center gap-5 pr-16 justify-around min-w-full"
                >
                  <span class="font-[600] text-lg tracking-tight text-gray-800"
                    >shopify</span
                  >
                  <span
                    data-animate="fade-up"
                    class="font-bold text-base tracking-tight text-gray-800"
                    >instacart</span
                  >
                  <span class="font-[600] text-lg tracking-wide text-gray-800"
                    >gusto</span
                  >
                  <span
                    data-animate="fade-up"
                    class="font-bold text-base text-gray-800">ramp</span
                  >
                  <span
                    data-animate="fade-up"
                    class="font-bold text-base tracking-tight text-gray-800"
                    >VERKADA</span
                  >
                  <span class="font-[500] text-base tracking-wide text-gray-800"
                    >Opendoor</span
                  >
                </div>
                <div
                  class="flex items-center gap-5 pr-16 justify-around min-w-full"
                >
                  <span class="font-[600] text-lg tracking-tight text-gray-800"
                    >shopify</span
                  >
                  <span
                    data-animate="fade-up"
                    class="font-bold text-base tracking-tight text-gray-800"
                    >instacart</span
                  >
                  <span class="font-[600] text-lg tracking-wide text-gray-800"
                    >gusto</span
                  >
                  <span
                    data-animate="fade-up"
                    class="font-bold text-base text-gray-800">ramp</span
                  >
                  <span
                    data-animate="fade-up"
                    class="font-bold text-base tracking-tight text-gray-800"
                    >VERKADA</span
                  >
                  <span class="font-[500] text-base tracking-wide text-gray-800"
                    >Opendoor</span
                  >
                </div>
              </div>
            </div>
          </div>
          <!-- Vertical Divider -->
          <div
            class="hidden lg:block lg:col-span-1 h-12 w-px bg-gray-200 mx-auto"
          >
          </div>
          <!-- High-impact Stats Counter -->
          <div
            class="lg:col-span-4 flex items-center justify-around text-center lg:text-left"
          >
            <div>
              <div
                data-animate="fade-up"
                class="text-3xl sm:text-4xl font-bold text-gray-950"
              >
                2.4B+
              </div>
              <div class="text-xs text-gray-500 font-medium mt-0.5">
                Signals analyzed weekly
              </div>
            </div>
            <div>
              <div
                data-animate="fade-up"
                class="text-3xl sm:text-4xl font-bold text-primary"
              >
                85,000+
              </div>
              <div class="text-xs text-gray-500 font-medium mt-0.5">
                Agents deployed live
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- 3. LET YOUR EXPERTS BUILD THE AGENTS (Gumloop 2-column feature block) -->
    <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" id="features">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Side: Editorial Storytelling -->
        <div class="lg:col-span-5">
          <div data-animate="fade-up" class="text-eyebrow text-primary mb-3">
            Build &amp; Deploy
          </div>
          <h2
            data-animate="fade-up"
            class="text-h2 text-gray-950 mb-5 leading-tight"
          >
            Let your revenue experts build the agents.
          </h2>
          <p class="text-base text-gray-600 mb-8 leading-relaxed">
            Understanding your buying persona and deal mechanics is the only
            prerequisite to automating it. No waitlists for engineering or
            waiting on RevOps bottlenecks.
          </p>
          <div class="flex items-center gap-3 mb-8">
            <a
              class="px-4 py-2 rounded-lg bg-black text-white text-xs font-medium hover:bg-neutral-800 transition-colors"
              href="#">Explore Agent Templates</a
            >
            <a
              class="px-4 py-2 rounded-lg bg-white border border-gray-300 text-gray-800 text-xs font-medium hover:bg-gray-50 transition-colors"
              href="#">Read documentation</a
            >
          </div>
          <!-- Feature Bullets (Gumloop custom list) -->
          <div class="grid grid-cols-2 gap-4 text-xs text-gray-700 font-medium">
            <div class="flex items-center gap-2">
              <span
                class="material-symbols-outlined text-[18px] text-primary"
                >bolt</span
              >
              <span>CRM &amp; Webhook Triggers</span>
            </div>
            <div class="flex items-center gap-2">
              <span
                class="material-symbols-outlined text-[18px] text-emerald-600"
                >sync</span
              >
              <span>Recurring Cron Schedules</span>
            </div>
            <div class="flex items-center gap-2">
              <span
                class="material-symbols-outlined text-[18px] text-purple-600"
                >hub</span
              >
              <span>150+ GTM Connectors</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[18px] text-pink-600"
                >auto_awesome</span
              >
              <span>Self-improving Prompts</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[18px] text-blue-600"
                >security</span
              >
              <span>Strict Data Hygiene</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-[18px] text-amber-600"
                >verified_user</span
              >
              <span>Human-in-the-loop Guardrails</span>
            </div>
          </div>
        </div>
        <!-- Right Side: Realistic SaaS Card (Call Analysis & Buying Committee Agent from Gumloop) -->
        <div class="lg:col-span-7" data-animate="fade-up">
          <Image
            src={imgFeature1}
            alt="Feature"
            class="w-full h-auto drop-shadow-2xl rounded-2xl border border-gray-200/50"
          />
        </div>
      </div>
    </section>
    <!-- 4. COMPLETE CONTEXT ON YOUR COMPANY (Gumloop Knowledge Graph + Multi-App Connectors) -->
    <section class="py-20 bg-white border-y border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <div data-animate="fade-up" class="text-eyebrow text-primary mb-2">
            Omniscient Context
          </div>
          <h2 data-animate="fade-up" class="text-h2 text-gray-950 mb-4">
            Complete context on your company &amp; deals.
          </h2>
          <p class="text-base text-gray-600">
            Your CRM notes, sales collateral, battlecards, product updates, and
            customer transcripts connect into one living intelligence graph.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Card 1: Knowledge Graph -->
          <div
            class="bg-gray-50 border border-gray-200/80 rounded-xl p-6 flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span
                  class="w-8 h-8 rounded-lg bg-primary-soft text-primary flex items-center justify-center font-bold"
                  ><span class="material-symbols-outlined text-[18px]"
                    >schema</span
                  ></span
                >
                <span
                  class="text-[10px] font-code bg-primary-soft text-primary px-2 py-0.5 rounded border border-primary/20"
                  >Dynamic Graph</span
                >
              </div>
              <h3
                data-animate="fade-up"
                class="font-[600] text-gray-900 text-[20px] mb-2"
              >
                Company Knowledge Graph
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed mb-4">
                Agents read and cite your verified documentation, pricing
                calculators, security whitepapers, and customer case studies
                without hallucination.
              </p>
            </div>
            <Image
              src={imgDiscover}
              alt="Graph"
              class="w-full h-auto mt-4 rounded-lg shadow-sm border border-gray-200/50"
            />
          </div>
          <!-- Card 2: Live Agent Activity Log -->
          <div
            class="bg-gray-50 border border-gray-200/80 rounded-xl p-6 flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span
                  class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold"
                  ><span class="material-symbols-outlined text-[18px]"
                    >monitoring</span
                  ></span
                >
                <span
                  class="text-[10px] font-code bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded border border-emerald-200"
                  >Live Feed</span
                >
              </div>
              <h3
                data-animate="fade-up"
                class="font-[600] text-gray-900 text-[20px] mb-2"
              >
                Live Agent Activity Log
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed mb-4">
                Monitor every action your agents take in real-time. See
                reasoning chains, data retrieval sources, and outbound messaging
                before it sends.
              </p>
            </div>
            <Image
              src={imgUnderstand}
              alt="Activity"
              class="w-full h-auto mt-4 rounded-lg shadow-sm border border-gray-200/50"
            />
          </div>
          <!-- Card 3: Extensible Skills Library -->
          <div
            class="bg-gray-50 border border-gray-200/80 rounded-xl p-6 flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span
                  class="w-8 h-8 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center font-bold"
                  ><span class="material-symbols-outlined text-[18px]"
                    >extension</span
                  ></span
                >
                <span
                  class="text-[10px] font-code bg-purple-50 text-purple-700 px-2 py-0.5 rounded border border-purple-200"
                  >Skill Library</span
                >
              </div>
              <h3
                data-animate="fade-up"
                class="font-[600] text-gray-900 text-[20px] mb-2"
              >
                Extensible Skills Library
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed mb-4">
                Equip agents with specific capabilities like LinkedIn scraping,
                SEC filing analysis, or personalized video generation via
                pre-built skills.
              </p>
            </div>
            <Image
              src={imgAct}
              alt="Skills"
              class="w-full h-auto mt-4 rounded-lg shadow-sm border border-gray-200/50"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 4B. MEET YOUR TEAM WHERE THEY ACTUALLY WORK -->
    <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left: Realistic Slack & Gmail Mock UI -->
        <div class="lg:col-span-7" data-animate="fade-up">
          <Image
            src={imgIntegrations}
            alt="Integrations"
            class="w-full h-auto drop-shadow-2xl rounded-2xl border border-gray-200/50"
          />
        </div>
        <!-- Right Side: Content -->
        <div class="lg:col-span-5">
          <div data-animate="fade-up" class="text-eyebrow text-primary mb-3">
            Collaboration
          </div>
          <h2
            data-animate="fade-up"
            class="text-h2 text-gray-950 mb-5 leading-tight"
          >
            Meet your team where they actually work.
          </h2>
          <p class="text-base text-gray-600 mb-6 leading-relaxed">
            Vero doesn't force your reps into another cumbersome destination
            tool. Agents deliver insights directly into Slack, email drafts
            right inside Gmail and Outlook, and push tasks into Salesforce
            automatically.
          </p>
          <div class="space-y-3 text-sm text-gray-700 font-medium">
            <div class="flex items-center gap-3">
              <span
                class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs"
                >✓</span
              ><span>Slack &amp; Microsoft Teams instant alert feeds</span>
            </div>
            <div class="flex items-center gap-3">
              <span
                class="w-6 h-6 rounded-full bg-primary-soft text-primary flex items-center justify-center text-xs"
                >✓</span
              ><span>Gmail &amp; Outlook 1-click tailored email injection</span>
            </div>
            <div class="flex items-center gap-3">
              <span
                class="w-6 h-6 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center text-xs"
                >✓</span
              ><span>Native Chrome extension for LinkedIn Sales Navigator</span>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- 5. ENTERPRISE-GRADE CONTROLS (Gumloop's Iconic Dark Container Section) -->
    <section
      class="py-24 bg-[#0a0c10] text-white relative overflow-hidden"
      id="enterprise"
    >
      <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-px bg-gradient-to-r from-transparent via-indigo-500/50 to-transparent"
      >
      </div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-16">
          <div data-animate="fade-up" class="text-eyebrow text-primary mb-2">
            Controls &amp; Governance
          </div>
          <h2 data-animate="fade-up" class="text-h2 text-white mb-4">
            Enterprise-grade controls and visibility.
          </h2>
          <p class="text-base text-gray-400">
            Granular spending budgets, audit logs, credential vaults, and
            sovereign cloud deployments built for the strictest compliance
            teams.
          </p>
        </div>
        <!-- Single Column Image -->
        <div class="w-full" data-animate="fade-up">
          <Image
            src={imgBannerPipeline}
            alt="Pipeline Analytics"
            class="w-full h-auto drop-shadow-2xl rounded-2xl border border-white/10"
          />
        </div>
        <!-- 4-Card Security & Governance Grid (Gumloop style) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-8">
          <div class="bg-[#12161f]/70 border border-white/10 p-4 rounded-xl">
            <div
              class="w-7 h-7 rounded-lg bg-primary/20 text-primary flex items-center justify-center mb-3"
            >
              <span class="material-symbols-outlined text-[18px]">verified</span
              >
            </div>
            <h5
              data-animate="fade-up"
              class="text-xs font-bold text-white mb-1"
            >
              SOC 2 Type II Certified
            </h5>
            <p class="text-[11px] text-gray-400">
              Independently audited annually with continuous monitoring via
              Vanta.
            </p>
          </div>
          <div class="bg-[#12161f]/70 border border-white/10 p-4 rounded-xl">
            <div
              class="w-7 h-7 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center mb-3"
            >
              <span class="material-symbols-outlined text-[18px]">vpn_key</span>
            </div>
            <h5
              data-animate="fade-up"
              class="text-xs font-bold text-white mb-1"
            >
              SAML SSO &amp; SCIM
            </h5>
            <p class="text-[11px] text-gray-400">
              Connect Okta, Google Workspace, Azure AD with role-based
              provisioning.
            </p>
          </div>
          <div class="bg-[#12161f]/70 border border-white/10 p-4 rounded-xl">
            <div
              class="w-7 h-7 rounded-lg bg-purple-500/20 text-purple-400 flex items-center justify-center mb-3"
            >
              <span class="material-symbols-outlined text-[18px]">gavel</span>
            </div>
            <h5
              data-animate="fade-up"
              class="text-xs font-bold text-white mb-1"
            >
              GDPR &amp; CCPA Sovereign
            </h5>
            <p class="text-[11px] text-gray-400">
              Automated opt-outs, right to erasure, and zero consumer PII
              persistence.
            </p>
          </div>
          <div class="bg-[#12161f]/70 border border-white/10 p-4 rounded-xl">
            <div
              class="w-7 h-7 rounded-lg bg-pink-500/20 text-pink-400 flex items-center justify-center mb-3"
            >
              <span class="material-symbols-outlined text-[18px]">lock</span>
            </div>
            <h5
              data-animate="fade-up"
              class="text-xs font-bold text-white mb-1"
            >
              Encrypted Credential Vault
            </h5>
            <p class="text-[11px] text-gray-400">
              API keys never exposed to users or LLM contexts. AES-256 at rest.
            </p>
          </div>
        </div>
      </div>
    </section>
    <!-- 6. CUSTOMER PROOF (Premium Bento Social Proof) -->
    <section
      class="py-32 bg-gradient-to-b from-white to-[#F8F9FA] relative overflow-hidden"
      id="customers"
    >
      <!-- Decorative background blur -->
      <div
        class="absolute top-0 right-0 -mr-40 -mt-40 w-[600px] h-[600px] bg-primary-soft/50 rounded-full blur-[100px] pointer-events-none"
      >
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
