---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/ui/layout/Container.astro";
import SectionHeading from "../components/ui/marketing/SectionHeading.astro";
import Hero from "../components/sections/Hero.astro";
import Button from "../components/ui/primitives/Button.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/images/vero-dashboard-hero.png";
import visualImg1 from "../assets/images/visual-image-1.png";
import visualImg2 from "../assets/images/visual-image-2.png";
import visualImg3 from "../assets/images/visual-image-3.png";
import visualImg4 from "../assets/images/visual-image-4.png";
import visualImg5 from "../assets/images/visual-image-5.png";
import visualImg6 from "../assets/images/visual-image-6.jpg";
import visualImg7VerticalLight from "../assets/images/visual-image-7-vertical-light.jpg";
import visualImg7VerticalDark from "../assets/images/visual-image-7-vertical-dark.jpg";
import visualImg8 from "../assets/images/visual-image-8.jpg";
import imgSales from "../assets/images/figma/card-sales.png";
import imgMarketing from "../assets/images/figma/card-marketing.png";
import imgRevops from "../assets/images/figma/card-revops.png";
import customerStoryIsometric from "../assets/images/customer-story-isometric.jpg";

// Product UI Components
import AccountIntelligence from "../components/sections/AccountIntelligence.astro";
import ProspectIntelligence from "../components/sections/ProspectIntelligence.astro";
import AIResearch from "../components/sections/AIResearch.astro";
import AIPersonalization from "../components/sections/AIPersonalization.astro";
import WorkflowBuilder from "../components/sections/WorkflowBuilder.astro";
import Pipeline from "../components/sections/Pipeline.astro";
import Analytics from "../components/sections/Analytics.astro";
import AIAgent from "../components/sections/AIAgent.astro";
import IntegrationUI from "../components/sections/IntegrationUI.astro";
---

<BaseLayout
  headerStyle="v1"
  footerStyle="v1"
  showAnnouncement={true}
  title="Vero - AI-Powered GTM Intelligence"
>
  <Hero src={heroImage} alt="Vero Dashboard" />

  <!-- Feature 1: Account Intelligence -->
  <section class="section py-8 lg:py-16 bg-gray-50 overflow-hidden">
    <Container>
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20 items-center"
      >
        <div class="relative z-10">
          <span class="text-eyebrow mb-4 block">ACCOUNT INTELLIGENCE</span>
          <h2 class="text-h2 mb-6">Know exactly who is ready to buy.</h2>
          <p class="text-body-large mb-8">
            Stop guessing who to contact. Vero analyzes billions of data points
            across the web to detect buying signals, intent changes, and key
            personnel moves in real-time.
          </p>
          <ul class="list-none p-0 m-0 mb-8 space-y-3">
            <li class="flex items-start gap-3 font-medium">
              <svg
                class="w-5 h-5 text-primary shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg
              > Real-time intent scoring
            </li>
            <li class="flex items-start gap-3 font-medium">
              <svg
                class="w-5 h-5 text-primary shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg
              > Funding & hiring signals
            </li>
            <li class="flex items-start gap-3 font-medium">
              <svg
                class="w-5 h-5 text-primary shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg
              > Technographics tracking
            </li>
          </ul>
        </div>
        <div class="relative rounded-xl shadow-xl bg-surface">
          <!-- <AccountIntelligence /> -->
          <Image
            src={visualImg1}
            alt="Vero Dashboard"
            class="w-full h-auto block"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- Feature 2: AI Research (Reverse) -->
  <section class="section py-8 lg:py-16 bg-white overflow-hidden">
    <Container>
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20 items-center"
      >
        <div class="relative z-10 lg:order-last">
          <span class="text-eyebrow mb-4 block">AI RESEARCH</span>
          <h2 class="text-h2 mb-6">Instant executive summaries.</h2>
          <p class="text-body-large mb-8">
            Vero's AI Agent automatically researches target accounts, analyzing
            10Ks, earnings calls, and news to generate concise executive
            summaries and tailored pitch recommendations before you ever reach
            out.
          </p>
          <ul class="list-none p-0 m-0 mb-8 space-y-3">
            <li class="flex items-start gap-3 font-medium">
              <svg
                class="w-5 h-5 text-primary shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg
              > Automated account planning
            </li>
            <li class="flex items-start gap-3 font-medium">
              <svg
                class="w-5 h-5 text-primary shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg
              > 10K & earnings call analysis
            </li>
            <li class="flex items-start gap-3 font-medium">
              <svg
                class="w-5 h-5 text-primary shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg
              > Trigger event monitoring
            </li>
          </ul>
        </div>
        <div
          class="relative rounded-xl shadow-xl bg-surface transform scale-105 lg:order-first"
        >
          <Image
            src={visualImg2}
            alt="Vero Dashboard"
            class="w-full h-auto block"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- Feature 3: Prospect Intelligence -->
  <section class="section py-8 lg:py-16 bg-gray-50 overflow-hidden">
    <Container>
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20 items-center"
      >
        <div class="relative z-10">
          <span class="text-eyebrow mb-4 block">PROSPECT INTELLIGENCE</span>
          <h2 class="text-h2 mb-6">Map the entire buying committee.</h2>
          <p class="text-body-large mb-8">
            Identify the decision makers, budget owners, and champions. Track
            their cross-channel engagement—from email opens to website visits
            and LinkedIn posts—all in one profile.
          </p>
          <ul class="list-none p-0 m-0 mb-8 space-y-3">
            <li class="flex items-start gap-3 font-medium">
              <svg
                class="w-5 h-5 text-primary shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg
              > Cross-channel engagement tracking
            </li>
            <li class="flex items-start gap-3 font-medium">
              <svg
                class="w-5 h-5 text-primary shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg
              > Buying committee visualization
            </li>
            <li class="flex items-start gap-3 font-medium">
              <svg
                class="w-5 h-5 text-primary shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg
              > Persona-based insights
            </li>
          </ul>
        </div>
        <div class="relative rounded-xl shadow-xl bg-surface">
          <Image
            src={visualImg3}
            alt="Vero Dashboard"
            class="w-full h-auto block"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- Feature 4: AI Personalization (Reverse) -->
  <section class="section py-8 lg:py-16 bg-white overflow-hidden">
    <Container>
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20 items-center"
      >
        <div class="relative z-10 lg:order-last">
          <span class="text-eyebrow mb-4 block">AI PERSONALIZATION</span>
          <h2 class="text-h2 mb-6">Hyper-personalized outreach at scale.</h2>
          <p class="text-body-large mb-8">
            Stop sending generic templates. Vero uses account insights and
            prospect activity to draft highly relevant, context-aware emails
            that get responses. Adjust tone and generate variations in one
            click.
          </p>
          <ul class="list-none p-0 m-0 mb-8 space-y-3">
            <li class="flex items-start gap-3 font-medium">
              <svg
                class="w-5 h-5 text-primary shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg
              > Context-aware generation
            </li>
            <li class="flex items-start gap-3 font-medium">
              <svg
                class="w-5 h-5 text-primary shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg
              > Tone and style controls
            </li>
            <li class="flex items-start gap-3 font-medium">
              <svg
                class="w-5 h-5 text-primary shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg
              > Success probability scoring
            </li>
          </ul>
        </div>
        <div class="relative rounded-xl shadow-xl bg-surface lg:order-first">
          <Image
            src={visualImg4}
            alt="Vero Dashboard"
            class="w-full h-auto block"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- Feature 5: Workflow Automation -->
  <section class="section py-8 lg:py-16 bg-gray-50 overflow-hidden">
    <Container>
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-20 items-center"
      >
        <div class="relative z-10">
          <span class="text-eyebrow mb-4 block">WORKFLOW AUTOMATION</span>
          <h2 class="text-h2 mb-6">
            Automate the work between signal and sale.
          </h2>
          <p class="text-body-large mb-8">
            Turn passive signals into active pipeline. Build visual, branching
            workflows that automatically route accounts, find decision makers,
            and trigger personalized sequences based on logic.
          </p>
          <ul class="list-none p-0 m-0 mb-8 space-y-3">
            <li class="flex items-start gap-3 font-medium">
              <svg
                class="w-5 h-5 text-primary shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg
              > Visual drag-and-drop builder
            </li>
            <li class="flex items-start gap-3 font-medium">
              <svg
                class="w-5 h-5 text-primary shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg
              > Branching conditional logic
            </li>
            <li class="flex items-start gap-3 font-medium">
              <svg
                class="w-5 h-5 text-primary shrink-0 mt-0.5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"><path d="M5 13l4 4L19 7"></path></svg
              > Hands-free pipeline generation
            </li>
          </ul>
        </div>
        <div class="relative rounded-xl shadow-xl bg-surface">
          <Image
            src={visualImg5}
            alt="Vero Dashboard"
            class="w-full h-auto block"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- 4. WORKFLOW GRID (DARK SECTION) -->
  <section class="py-[80px] bg-[#1D1D22] text-white border-y border-[#37363C]">
    <div class="max-w-[1180px] mx-auto px-4 text-left">
      <div data-animate="fade-up" class="mb-14">
        <span
          class="text-[#85848D] font-[800] tracking-[0.105em] text-[12px] mb-4 block uppercase"
          >02 / ONE CONTINUOUS WORKFLOW</span
        >
        <h2 class="text-h2 text-white max-w-[600px]">
          From market signal to meaningful conversation.
        </h2>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-y-12 lg:gap-y-0"
      >
        <!-- Step 1 -->
        <div
          data-animate="fade-up"
          class="px-2 lg:px-6 relative border-b lg:border-b-0 lg:border-r border-[#37363C] last:border-0 pb-8 lg:pb-0 first:pl-0 last:pr-0"
        >
          <div class="text-[#74737A] font-[400] text-[12px] mb-[40px]">01</div>
          <!-- Arrow on border -->
          <!-- <div class="absolute -right-[7px] top-[0px] text-[#4F4E54] text-[14px] bg-[#1D1D22] py-1 leading-none hidden lg:block">
              &rarr;
            </div> -->
          <div
            class="w-[36px] h-[36px] rounded-[8px] bg-[#26243A] text-[#7465D4] flex items-center justify-center mb-6"
          >
            <span class="material-symbols-outlined text-[18px]">search</span>
          </div>
          <h3 class="text-[16px] font-[500] text-[#EEEEEE] mb-2">Discover</h3>
          <p class="text-[#85848D] text-[13px] leading-[20px] pr-2">
            Find accounts showing real buying intent.
          </p>
        </div>

        <!-- Step 2 -->
        <div
          data-animate="fade-up"
          class="px-2 lg:px-6 relative border-b lg:border-b-0 lg:border-r border-[#37363C] last:border-0 pb-8 lg:pb-0 first:pl-0 last:pr-0"
        >
          <div class="text-[#74737A] font-[400] text-[12px] mb-[40px]">02</div>
          <!-- Arrow on border -->
          <!-- <div class="absolute -right-[7px] top-[0px] text-[#4F4E54] text-[14px] bg-[#1D1D22] py-1 leading-none hidden lg:block">
              &rarr;
            </div> -->
          <div
            class="w-[36px] h-[36px] rounded-[8px] bg-[#26243A] text-[#7465D4] flex items-center justify-center mb-6"
          >
            <span class="material-symbols-outlined text-[18px]"
              >receipt_long</span
            >
          </div>
          <h3 class="text-[16px] font-[500] text-[#EEEEEE] mb-2">Enrich</h3>
          <p class="text-[#85848D] text-[13px] leading-[20px] pr-2">
            Complete every account and contact record.
          </p>
        </div>

        <!-- Step 3 -->
        <div
          data-animate="fade-up"
          class="px-2 lg:px-6 relative border-b lg:border-b-0 lg:border-r border-[#37363C] last:border-0 pb-8 lg:pb-0 first:pl-0 last:pr-0"
        >
          <div class="text-[#74737A] font-[400] text-[12px] mb-[40px]">03</div>
          <!-- Arrow on border -->
          <!-- <div class="absolute -right-[7px] top-[0px] text-[#4F4E54] text-[14px] bg-[#1D1D22] py-1 leading-none hidden lg:block">
              &rarr;
            </div> -->
          <div
            class="w-[36px] h-[36px] rounded-[8px] bg-[#1F2D2A] text-[#459B71] flex items-center justify-center mb-6"
          >
            <span class="material-symbols-outlined text-[18px]"
              >temp_preferences_custom</span
            >
          </div>
          <h3 class="text-[16px] font-[500] text-[#EEEEEE] mb-2">Understand</h3>
          <p class="text-[#85848D] text-[13px] leading-[20px] pr-2">
            Turn activity into a clear buying narrative.
          </p>
        </div>

        <!-- Step 4 -->
        <div
          data-animate="fade-up"
          class="px-2 lg:px-6 relative border-b lg:border-b-0 lg:border-r border-[#37363C] last:border-0 pb-8 lg:pb-0 first:pl-0 last:pr-0"
        >
          <div class="text-[#74737A] font-[400] text-[12px] mb-[40px]">04</div>
          <!-- Arrow on border -->
          <!-- <div class="absolute -right-[7px] top-[0px] text-[#4F4E54] text-[14px] bg-[#1D1D22] py-1 leading-none hidden lg:block">
              &rarr;
            </div> -->
          <div
            class="w-[36px] h-[36px] rounded-[8px] bg-[#26243A] text-[#7465D4] flex items-center justify-center mb-6"
          >
            <span class="material-symbols-outlined text-[18px]">group</span>
          </div>
          <h3 class="text-[16px] font-[500] text-[#EEEEEE] mb-2">
            Personalize
          </h3>
          <p class="text-[#85848D] text-[13px] leading-[20px] pr-2">
            Create relevant messaging for each person.
          </p>
        </div>

        <!-- Step 5 -->
        <div
          data-animate="fade-up"
          class="px-2 lg:px-6 relative border-b lg:border-b-0 lg:border-r border-[#37363C] last:border-0 pb-8 lg:pb-0 first:pl-0 last:pr-0"
        >
          <div class="text-[#74737A] font-[400] text-[12px] mb-[40px]">05</div>
          <!-- Arrow on border -->
          <!-- <div class="absolute -right-[7px] top-[0px] text-[#4F4E54] text-[14px] bg-[#1D1D22] py-1 leading-none hidden lg:block">
              &rarr;
            </div> -->
          <div
            class="w-[36px] h-[36px] rounded-[8px] bg-[#1F2D2A] text-[#459B71] flex items-center justify-center mb-6"
          >
            <span class="material-symbols-outlined text-[18px]">bolt</span>
          </div>
          <h3 class="text-[16px] font-[500] text-[#EEEEEE] mb-2">Engage</h3>
          <p class="text-[#85848D] text-[13px] leading-[20px] pr-2">
            Activate coordinated plays across channels.
          </p>
        </div>

        <!-- Step 6 -->
        <div
          data-animate="fade-up"
          class="px-2 lg:px-6 relative last:border-0 pb-8 lg:pb-0 first:pl-0 last:pr-0"
        >
          <div class="text-[#74737A] font-[400] text-[12px] mb-[40px]">06</div>
          <div
            class="w-[36px] h-[36px] rounded-[8px] bg-[#26243A] text-[#7465D4] flex items-center justify-center mb-6"
          >
            <span class="material-symbols-outlined text-[18px]">code</span>
          </div>
          <h3 class="text-[16px] font-[500] text-[#EEEEEE] mb-2">Sync</h3>
          <p class="text-[#85848D] text-[13px] leading-[20px] pr-2">
            Keep your systems and teams aligned.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature 6: AI Agent (Centered Feature) -->
  <section class="section py-12 lg:py-24 bg-white relative overflow-hidden">
    <!-- Soft Ambient Warm Background Glow -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-5xl h-[450px] bg-[radial-gradient(ellipse_60%_50%_at_50%_50%,rgba(234,88,12,0.06)_0%,transparent_70%)] pointer-events-none -z-10"
    >
    </div>

    <Container>
      <SectionHeading
        eyebrow="MEET VERO AI"
        title="Your dedicated revenue co-pilot."
        description="Interact with your GTM data naturally. Ask Vero AI to research competitors, summarize pipeline risks, or identify new ICP matches."
      />
      <div
        class="visual-centered mt-12 max-w-5xl mx-auto rounded-2xl border border-gray-200/90 shadow-[0_25px_60px_-15px_rgba(234,88,12,0.12),0_12px_28px_-6px_rgba(15,23,42,0.06)] overflow-hidden bg-white transition-all duration-300 hover:shadow-[0_30px_70px_-15px_rgba(234,88,12,0.18)]"
      >
        <Image
          src={visualImg6}
          alt="Vero AI Revenue Copilot Dashboard"
          class="w-full h-auto block"
        />
      </div>
    </Container>
  </section>

  <!-- Feature 7: Integrations & Analytics Grid -->
  <section class="section py-12 lg:py-24 bg-gray-50 overflow-hidden">
    <Container>
      <SectionHeading
        eyebrow="CONNECTED & MEASURABLE"
        title="Works with your stack. Proves your ROI."
        description="Vero integrates bi-directionally with your CRM and provides deep analytics to measure what's working."
      />

      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 mt-16">
        <div
          class="bg-white rounded-xl border border-border shadow-md overflow-hidden flex flex-col col-span-2"
        >
          <div class="p-8 flex flex-col h-full">
            <h3 class="text-xl font-bold mb-2">Native Integrations</h3>
            <p class="text-muted text-sm mb-6">
              Sync accounts, contacts, and opportunities seamlessly.
            </p>
            <div
              class="relative rounded-xl overflow-hidden border border-border mt-auto"
            >
              <Image
                src={visualImg7VerticalLight}
                alt="Native Integrations"
                class="w-full h-auto block"
              />
            </div>
          </div>
        </div>
        <div
          class="bg-white rounded-xl border border-border shadow-md overflow-hidden flex flex-col col-span-3"
        >
          <div class="p-8 flex flex-col h-full">
            <h3 class="text-xl font-bold mb-2">Revenue Analytics</h3>
            <p class="text-muted text-sm mb-6">
              Track pipeline created, win rates, and sales cycles in real-time.
            </p>
            <div
              class="relative rounded-xl overflow-hidden border border-border mt-auto"
            >
              <Image
                src={visualImg8}
                alt="Revenue Analytics"
                class="w-full h-auto block"
              />
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 7. CUSTOMER STORY -->
  <section class="py-12 lg:py-24 bg-gray-50 overflow-hidden relative">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 flex flex-col gap-10 lg:gap-14">
      <div data-animate="fade-up" class="flex gap-4 items-center">
        <span
          class="text-[12px] font-[800] tracking-[0.093em] text-[#87868B] uppercase"
          >CUSTOMER STORY</span
        >
        <div class="h-px bg-gray-200 flex-1"></div>
      </div>

      <div data-animate="fade-up" class="grid grid-cols-1 lg:grid-cols-12 gap-10 xl:gap-16 items-center">
        <!-- LEFT COLUMN: Testimonial Quotes Slider (7 Cols) -->
        <div class="lg:col-span-7 relative">
          <div
            class="grid grid-cols-1 grid-rows-1 w-full min-h-[340px] sm:min-h-[290px]"
            id="testimonial-slider"
          >
            <!-- Slide 1 -->
            <div
              class="testimonial-slide col-start-1 row-start-1 w-full transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] opacity-100 z-10 translate-x-0"
            >
              <div class="flex items-center gap-3 mb-6 sm:mb-8">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-100/80 text-primary text-[11px] font-bold tracking-wide uppercase">
                  <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                  Northstar Labs
                </span>
                <span class="text-xs text-gray-400">· 1,400+ Enterprise SDRs</span>
              </div>
              <h3
                class="text-2xl sm:text-3xl lg:text-[36px] font-medium text-gray-950 leading-[1.28] tracking-[-0.035em] mb-6 sm:mb-8"
              >
                “Vero gave our team a shared understanding of where demand was
                forming—then helped us act before the market caught up.”
              </h3>
